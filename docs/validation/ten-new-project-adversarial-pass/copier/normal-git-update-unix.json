{
  "version": 2,
  "name": "Actual v1 to v2 template update with a new answer and preserved committed local file",
  "command": [
    "copier",
    "update",
    "--skip-answered",
    "updated"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Support level"
    },
    {
      "key": "CtrlA"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "premium"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "snapshot": "normal-git-update-unix.rows.json"
    }
  ]
}
