{
  "version": 2,
  "name": "Cancellation after editing leaves no generated project",
  "command": [
    "copier",
    "copy",
    "templates/basic",
    "project"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Project name"
    },
    {
      "key": "CtrlA"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "Abandoned"
    },
    {
      "key": "CtrlC"
    },
    {
      "expect": "Execution stopped by user"
    },
    {
      "exit": 1
    },
    {
      "snapshot": "edge-cancel-after-edit.txt"
    }
  ]
}
