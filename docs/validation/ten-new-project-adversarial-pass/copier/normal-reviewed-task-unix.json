{
  "version": 2,
  "name": "Explicit trust for one reviewed local marker-writing task",
  "command": [
    "copier",
    "copy",
    "--trust",
    "templates/hooked",
    "project"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Component name"
    },
    {
      "key": "CtrlA"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "engine"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "snapshot": "normal-reviewed-task-unix.rows.json"
    }
  ]
}
