{
  "version": 2,
  "name": "Invalid integer input rejected and corrected to an exact numeric state",
  "command": [
    "copier",
    "copy",
    "templates/integer",
    "project"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Worker count"
    },
    {
      "key": "CtrlA"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "abc"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Invalid input"
    },
    {
      "key": "CtrlA"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "7"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "snapshot": "edge-integer-recovery-unix.txt"
    }
  ]
}
