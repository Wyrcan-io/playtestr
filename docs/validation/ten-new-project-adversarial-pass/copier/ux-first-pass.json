{
  "version": 2,
  "name": "Dependent project files and nondefault keyboard-selected license",
  "command": [
    "copier",
    "copy",
    "templates/basic",
    "project"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Project name"
    },
    {
      "key": "CtrlA"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "Atlas"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Project slug"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "License"
    },
    {
      "key": "ArrowDown"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "snapshot": "ux-first-pass.txt"
    }
  ]
}
