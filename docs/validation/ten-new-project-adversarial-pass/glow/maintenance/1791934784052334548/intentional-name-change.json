{
  "version": 2,
  "name": "Reviewed intentional workflow change",
  "command": [
    "glow",
    "--style",
    "dark",
    "--mouse=false"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "GLAMOUR_STYLE": "dark",
    "GLOW_TEXT_SIZING": "off",
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "6 documents"
    },
    {
      "text": "/"
    },
    {
      "text": "guide"
    },
    {
      "expect": "│ guide.md"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "guide DOCUMENT TOKEN"
    },
    {
      "snapshot": "normal-project.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
