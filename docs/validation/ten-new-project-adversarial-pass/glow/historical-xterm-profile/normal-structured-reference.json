{
  "version": 2,
  "name": "Read rendered code and a Markdown table without changing source",
  "command": [
    "glow",
    "--style",
    "dark",
    "--mouse=false",
    "--tui",
    "structured.md"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "GLAMOUR_STYLE": "dark",
    "GLOW_TEXT_SIZING": "off",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "STRUCTURED REFERENCE TOKEN"
    },
    {
      "expect": "CODE BLOCK TOKEN"
    },
    {
      "expect": "TABLE CELL TOKEN"
    },
    {
      "snapshot": "normal-structured-reference.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
