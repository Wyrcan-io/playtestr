{
  "version": 2,
  "name": "Recover from a long unmatched input and select a Unicode filename",
  "command": [
    "glow",
    "--style",
    "dark",
    "--mouse=false"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "GLAMOUR_STYLE": "dark",
    "GLOW_TEXT_SIZING": "off",
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "6 documents"
    },
    {
      "text": "/"
    },
    {
      "text": "UNMATCHEDZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ"
    },
    {
      "expect": "Find: ZZZZZZZZZZZZ"
    },
    {
      "expect": "No files found."
    },
    {
      "key": "Escape"
    },
    {
      "expect": "6 documents"
    },
    {
      "text": "/"
    },
    {
      "text": "notes cafe"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "NESTED UNICODE café 雪 TOKEN"
    },
    {
      "snapshot": "edge-long-filter-recovery.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
