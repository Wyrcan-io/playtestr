{
  "version": 2,
  "name": "Repeatedly resize and navigate a long Unicode document without saving unwanted edits",
  "command": [
    "hx",
    "--config",
    ".configuration/config.toml",
    "long.txt"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "line 00: long text café 雪"
    },
    {
      "resize": {
        "width": 80,
        "height": 24
      }
    },
    {
      "text": "ge"
    },
    {
      "expect": "line 59: long text café 雪"
    },
    {
      "resize": {
        "width": 120,
        "height": 35
      }
    },
    {
      "text": "gg"
    },
    {
      "expect": "line 00: long text café 雪"
    },
    {
      "resize": {
        "width": 100,
        "height": 30
      }
    },
    {
      "text": "ge"
    },
    {
      "expect": "line 59: long text café 雪"
    },
    {
      "snapshot": "edge-resize-scroll.rows.json"
    },
    {
      "text": ":q"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    }
  ]
}
