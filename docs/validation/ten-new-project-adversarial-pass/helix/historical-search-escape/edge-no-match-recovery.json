{
  "version": 2,
  "name": "Search for a missing token, cancel, and search a real noninitial line",
  "command": [
    "hx",
    "--config",
    ".configuration/config.toml",
    "main.txt"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "ORIGINAL MAIN TOKEN"
    },
    {
      "text": "/"
    },
    {
      "text": "ABSENT NEVER TOKEN"
    },
    {
      "key": "Enter"
    },
    {
      "text": "n"
    },
    {
      "expect": "No more matches"
    },
    {
      "key": "Escape"
    },
    {
      "text": "/"
    },
    {
      "expect": "search:"
    },
    {
      "text": "Protected second line"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "search:"
    },
    {
      "expect": "Protected second line."
    },
    {
      "snapshot": "edge-no-match-recovery.rows.json"
    },
    {
      "text": ":q"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    }
  ]
}
