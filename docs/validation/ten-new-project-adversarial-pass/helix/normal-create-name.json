{
  "version": 2,
  "name": "Create and save a new spaced Unicode filename from an empty buffer",
  "command": [
    "hx",
    "--config",
    ".configuration/config.toml"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "NOR  [scratch]"
    },
    {
      "text": "i"
    },
    {
      "expect": "INS"
    },
    {
      "text": "NEW FILE TOKEN café 雪"
    },
    {
      "key": "Escape"
    },
    {
      "expect": "NOR"
    },
    {
      "text": ":write \"created café.txt\""
    },
    {
      "key": "Enter"
    },
    {
      "expect": "'created café.txt' written"
    },
    {
      "snapshot": "normal-create-name.rows.json"
    },
    {
      "text": ":q"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    }
  ]
}
