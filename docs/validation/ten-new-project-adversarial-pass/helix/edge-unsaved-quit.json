{
  "version": 2,
  "name": "Reject an ordinary quit with unsaved bytes, then explicitly discard them",
  "command": [
    "hx",
    "--config",
    ".configuration/config.toml",
    "main.txt"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "ORIGINAL MAIN TOKEN"
    },
    {
      "text": "%"
    },
    {
      "text": "c"
    },
    {
      "expect": "INS"
    },
    {
      "text": "UNSAVED NEVER PERSIST TOKEN"
    },
    {
      "key": "Escape"
    },
    {
      "expect": "NOR"
    },
    {
      "text": ":q"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "unsaved buffer"
    },
    {
      "expect": "UNSAVED NEVER PERSIST TOKEN"
    },
    {
      "snapshot": "edge-unsaved-quit.rows.json"
    },
    {
      "text": ":q!"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    }
  ]
}
