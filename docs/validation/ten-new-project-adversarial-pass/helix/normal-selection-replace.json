{
  "version": 2,
  "name": "Replace one selected word and preserve surrounding words and lines",
  "command": [
    "hx",
    "--config",
    ".configuration/config.toml",
    "selection.txt"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha bravo charlie"
    },
    {
      "text": "e"
    },
    {
      "text": "c"
    },
    {
      "text": "ALPHA"
    },
    {
      "key": "Escape"
    },
    {
      "expect": "ALPHA bravo charlie"
    },
    {
      "text": ":w"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "'selection.txt' written"
    },
    {
      "snapshot": "normal-selection-replace.rows.json"
    },
    {
      "text": ":q"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    }
  ]
}
