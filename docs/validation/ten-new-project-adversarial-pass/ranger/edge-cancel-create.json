{
  "version": 2,
  "name": "Cancel a populated create command without altering any fixture entry",
  "command": [
    "ranger",
    "--clean",
    "--cmd=set preview_files true",
    "--cmd=set use_preview_script false",
    "--cmd=set confirm_on_delete always",
    "--cmd=set hostname_in_titlebar false",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "expect": "All"
    },
    {
      "text": ":"
    },
    {
      "expect_not": "All"
    },
    {
      "expect": ":"
    },
    {
      "text": "touch not-created café.txt"
    },
    {
      "expect": ":touch not-created café.txt"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": ":touch not-created café.txt"
    },
    {
      "expect": "All"
    },
    {
      "snapshot": "edge-cancel-create.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
