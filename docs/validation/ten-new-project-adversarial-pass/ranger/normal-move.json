{
  "version": 2,
  "name": "Move a noninitial file, inspect its bytes and verify the old path disappears",
  "command": [
    "ranger",
    "--clean",
    "--cmd=set preview_files true",
    "--cmd=set use_preview_script false",
    "--cmd=set confirm_on_delete always",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "text": "/"
    },
    {
      "expect": ":search"
    },
    {
      "text": "bravo"
    },
    {
      "expect": ":search bravo"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": ":search bravo"
    },
    {
      "expect": "/fixture/bravo.txt"
    },
    {
      "expect": "RANGER BRAVO ORIGINAL TOKEN"
    },
    {
      "expect": "All"
    },
    {
      "text": ":"
    },
    {
      "expect_not": "All"
    },
    {
      "expect": ":"
    },
    {
      "text": "cut"
    },
    {
      "expect": ":cut"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": ":cut"
    },
    {
      "expect": "All"
    },
    {
      "text": "/"
    },
    {
      "expect": ":search"
    },
    {
      "text": "nested"
    },
    {
      "expect": ":search nested"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": ":search nested"
    },
    {
      "expect": "/fixture/nested"
    },
    {
      "text": "l"
    },
    {
      "expect": "/fixture/nested/notes café.txt"
    },
    {
      "expect": "RANGER NESTED UNICODE TOKEN"
    },
    {
      "expect": "All"
    },
    {
      "text": ":"
    },
    {
      "expect_not": "All"
    },
    {
      "expect": ":"
    },
    {
      "text": "paste"
    },
    {
      "expect": ":paste"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": ":paste"
    },
    {
      "expect": "All"
    },
    {
      "expect": "bravo.txt                      28 B"
    },
    {
      "text": "/"
    },
    {
      "expect": ":search"
    },
    {
      "text": "bravo"
    },
    {
      "expect": ":search bravo"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": ":search bravo"
    },
    {
      "expect": "/fixture/nested/bravo.txt"
    },
    {
      "expect": "RANGER BRAVO ORIGINAL TOKEN"
    },
    {
      "text": "h"
    },
    {
      "expect": "protected.txt                  32 B"
    },
    {
      "snapshot": "normal-move.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
