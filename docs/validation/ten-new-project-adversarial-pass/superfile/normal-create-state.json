{
  "version": 2,
  "name": "Create a nested spaced Unicode file with its parent directory through the ordinary prompt",
  "command": [
    "superfile",
    "--config-file",
    ".configuration/config.toml",
    "source"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Thanks for using superfile"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Thanks for using superfile"
    },
    {
      "expect": "ALPHA PREVIEW TOKEN"
    },
    {
      "key": "CtrlN"
    },
    {
      "expect": "transcend folders"
    },
    {
      "text": "fresh folder/new café.txt"
    },
    {
      "key": "Enter"
    },
    {
      "text": "/"
    },
    {
      "text": "fresh folder"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "\u003e  fresh folder"
    },
    {
      "key": "ArrowRight"
    },
    {
      "expect": "\u003e  new café.txt"
    },
    {
      "snapshot": "normal-create-state.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
