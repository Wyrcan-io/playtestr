{
  "version": 2,
  "name": "Resize repeatedly, search an initially offscreen item and inspect Unicode long content",
  "command": [
    "superfile",
    "--config-file",
    ".configuration/config.toml",
    "source"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Thanks for using superfile"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Thanks for using superfile"
    },
    {
      "expect": "ALPHA PREVIEW TOKEN"
    },
    {
      "resize": {
        "width": 80,
        "height": 24
      }
    },
    {
      "text": "/"
    },
    {
      "text": "scroll-34.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "SCROLL ITEM 34 TOKEN"
    },
    {
      "text": "/"
    },
    {
      "key": "CtrlA"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "long.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "line 00: long preview café 雪"
    },
    {
      "resize": {
        "width": 120,
        "height": 35
      }
    },
    {
      "expect": "line 20: long preview café 雪"
    },
    {
      "resize": {
        "width": 100,
        "height": 30
      }
    },
    {
      "text": "/"
    },
    {
      "key": "CtrlA"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "scroll-33.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "SCROLL ITEM 33 TOKEN"
    },
    {
      "snapshot": "edge-resize-scroll.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
