{
  "version": 2,
  "name": "Search a noninitial nested file and inspect its exact preview",
  "command": [
    "superfile",
    "--config-file",
    ".configuration/config.toml",
    "nested"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Thanks for using superfile"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Thanks for using superfile"
    },
    {
      "expect": "NESTED NOTES TOKEN"
    },
    {
      "text": "/"
    },
    {
      "text": "plan.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "NONINITIAL PLAN TOKEN"
    },
    {
      "expect": "Second exact line."
    },
    {
      "snapshot": "normal-search-preview.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
