{
  "version": 2,
  "name": "Cancel after editing a filename and preserve exact original and neighboring bytes",
  "command": [
    "superfile",
    "--config-file",
    ".configuration/config.toml",
    "source"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Thanks for using superfile"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Thanks for using superfile"
    },
    {
      "expect": "ALPHA PREVIEW TOKEN"
    },
    {
      "key": "CtrlR"
    },
    {
      "key": "CtrlA"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "abandoned-name.txt"
    },
    {
      "expect": "abandoned-name.txt"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "abandoned-name.txt"
    },
    {
      "key": "ArrowDown"
    },
    {
      "expect": "BRAVO MOVE TOKEN"
    },
    {
      "snapshot": "edge-cancel-edited-rename.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
