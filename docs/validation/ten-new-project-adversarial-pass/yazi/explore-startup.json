{
  "version": 2,
  "name": "Observe the actual ordinary startup and quit; no scenario credit",
  "command": [
    "yazi",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "snapshot": "explore-startup.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
