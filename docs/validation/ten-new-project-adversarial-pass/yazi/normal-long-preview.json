{
  "version": 2,
  "name": "Scroll a long Unicode text preview using ordinary preview keys",
  "command": [
    "yazi",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "text": "/"
    },
    {
      "expect": "Find next:"
    },
    {
      "text": "long"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Find next:"
    },
    {
      "expect": "(find: long)"
    },
    {
      "expect": "󰈙 long.txt"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "(find: long)"
    },
    {
      "expect": "line 00:"
    },
    {
      "expect": "line 14:"
    },
    {
      "text": "J"
    },
    {
      "expect": "line 40:"
    },
    {
      "expect_not": "line 00:"
    },
    {
      "text": "J"
    },
    {
      "expect": "line 54:"
    },
    {
      "expect_not": "line 14:"
    },
    {
      "snapshot": "normal-long-preview.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
