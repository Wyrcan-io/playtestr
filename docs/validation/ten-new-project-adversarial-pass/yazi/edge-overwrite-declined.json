{
  "version": 2,
  "name": "Decline overwriting an occupied file and preserve its bytes",
  "command": [
    "yazi",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "text": "a"
    },
    {
      "expect": "Create:"
    },
    {
      "text": "alpha.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Overwrite file?"
    },
    {
      "text": "n"
    },
    {
      "expect_not": "Overwrite file?"
    },
    {
      "text": "/"
    },
    {
      "expect": "Find next:"
    },
    {
      "text": "protected"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Find next:"
    },
    {
      "expect": "(find: protected)"
    },
    {
      "expect": "󰈙 protected.txt"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "(find: protected)"
    },
    {
      "expect": "PROTECTED NEIGHBOR TOKEN"
    },
    {
      "snapshot": "edge-overwrite-declined.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
