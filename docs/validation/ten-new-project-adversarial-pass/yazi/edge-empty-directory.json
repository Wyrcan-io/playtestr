{
  "version": 2,
  "name": "Enter a truly empty directory and exit naturally",
  "command": [
    "yazi",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "text": "/"
    },
    {
      "expect": "Find next:"
    },
    {
      "text": "empty"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Find next:"
    },
    {
      "expect": "(find: empty)"
    },
    {
      "expect": " empty"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "(find: empty)"
    },
    {
      "text": "l"
    },
    {
      "expect": "/fixture/empty"
    },
    {
      "expect": "No items"
    },
    {
      "snapshot": "edge-empty-directory.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
