{
  "version": 2,
  "name": "Navigate two distinct directories and inspect their actual text files",
  "command": [
    "yazi",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "text": "/"
    },
    {
      "expect": "Find next:"
    },
    {
      "text": "nested"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Find next:"
    },
    {
      "expect": "(find: nested)"
    },
    {
      "expect": " nested"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "(find: nested)"
    },
    {
      "text": "l"
    },
    {
      "expect": "/fixture/nested"
    },
    {
      "expect": "󰈙 notes café.txt"
    },
    {
      "expect": "NESTED UNICODE NOTES TOKEN"
    },
    {
      "text": "h"
    },
    {
      "expect": " fixture"
    },
    {
      "text": "/"
    },
    {
      "expect": "Find next:"
    },
    {
      "text": "occupied"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Find next:"
    },
    {
      "expect": "(find: occupied)"
    },
    {
      "expect": " occupied"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "(find: occupied)"
    },
    {
      "text": "l"
    },
    {
      "expect": "/fixture/occupied"
    },
    {
      "expect": "OCCUPIED DIRECTORY TOKEN"
    },
    {
      "snapshot": "normal-nested-navigation.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
