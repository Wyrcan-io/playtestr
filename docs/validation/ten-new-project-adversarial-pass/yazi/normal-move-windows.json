{
  "version": 2,
  "name": "Move a noninitial file and verify destination bytes and original absence",
  "command": [
    "yazi",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "text": "/"
    },
    {
      "expect": "Find next:"
    },
    {
      "text": "bravo"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Find next:"
    },
    {
      "expect": "(find: bravo)"
    },
    {
      "expect": "󰈙 bravo.txt"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "(find: bravo)"
    },
    {
      "text": "x"
    },
    {
      "text": "/"
    },
    {
      "expect": "Find next:"
    },
    {
      "text": "nested"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Find next:"
    },
    {
      "expect": "(find: nested)"
    },
    {
      "expect": " nested"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "(find: nested)"
    },
    {
      "text": "l"
    },
    {
      "expect": "\\fixture\\nested"
    },
    {
      "expect": "󰈙 notes café.txt"
    },
    {
      "text": "p"
    },
    {
      "expect": "󰈙 bravo.txt"
    },
    {
      "expect": "BRAVO ORIGINAL TOKEN"
    },
    {
      "text": "h"
    },
    {
      "expect": " fixture"
    },
    {
      "snapshot": "normal-move-windows.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
