{
  "version": 2,
  "name": "Create nested Unicode directories and verify actual directory types",
  "command": [
    "yazi",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "text": "a"
    },
    {
      "expect": "Create:"
    },
    {
      "text": "created dir café/sub/"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Create:"
    },
    {
      "expect": "\\fixture\\created dir café"
    },
    {
      "expect": " sub"
    },
    {
      "text": "l"
    },
    {
      "expect": "\\fixture\\created dir café\\sub"
    },
    {
      "expect": "No items"
    },
    {
      "snapshot": "normal-directory-windows.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
