# Retained contracts/fixtures/patches must preserve their recorded bytes.
** -text whitespace=cr-at-eol
*.patch whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof,-space-before-tab
**/UPSTREAM-LICENSE.txt whitespace=cr-at-eol,-blank-at-eof
# Exact unified diffs include a space on otherwise blank context rows.
**/first-failures/*-diff_path.txt whitespace=cr-at-eol,-blank-at-eol
**/fault-evidence/**/*.diff.txt whitespace=cr-at-eol,-blank-at-eol
# Exact interactive prompt transcripts contain intentional trailing spaces.
lf/first-failures/*.txt whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
superfile/first-failures/*.txt whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
helix/first-failures/*.txt whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Licensed upstream TOML comments retain their exact whitespace.
superfile/**/.configuration/config.toml whitespace=cr-at-eol,-blank-at-eol
