{
  "version": 2,
  "name": "Enter a genuinely empty directory while preserving all other fixture entries",
  "command": [
    "nnn",
    "-A",
    "-C",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "expect": "bravo.txt"
    },
    {
      "text": "/"
    },
    {
      "expect": "str [/], ic [:]"
    },
    {
      "text": "empty"
    },
    {
      "expect": "/empty"
    },
    {
      "expect_not": "alpha.txt"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "str [/], ic [:]"
    },
    {
      "expect": "empty/"
    },
    {
      "text": "l"
    },
    {
      "expect": "/fixture/empty"
    },
    {
      "expect_not": "empty/"
    },
    {
      "expect": "0/0"
    },
    {
      "snapshot": "edge-empty-directory.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
