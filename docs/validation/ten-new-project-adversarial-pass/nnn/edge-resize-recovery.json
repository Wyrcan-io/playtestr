{
  "version": 2,
  "name": "Resize a scrolled 200-file list, navigate home, restore geometry and return to the last entry",
  "command": [
    "nnn",
    "-A",
    "-C",
    "."
  ],
  "workspace": {
    "fixture": "fixtures-large",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "entry 000.txt*"
    },
    {
      "expect": "1/200"
    },
    {
      "key": "End"
    },
    {
      "expect": "200/200"
    },
    {
      "expect": "entry 199.txt*"
    },
    {
      "resize": {
        "width": 80,
        "height": 24
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "key": "Home"
    },
    {
      "expect": "1/200"
    },
    {
      "expect": "entry 000.txt*"
    },
    {
      "snapshot": "edge-resize-recovery.rows.json"
    },
    {
      "resize": {
        "width": 100,
        "height": 30
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "key": "End"
    },
    {
      "expect": "200/200"
    },
    {
      "expect": "entry 199.txt*"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
