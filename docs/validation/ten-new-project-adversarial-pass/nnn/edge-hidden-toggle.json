{
  "version": 2,
  "name": "Reveal a real hidden file, hide it again and preserve its exact contents",
  "command": [
    "nnn",
    "-A",
    "-C",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "expect": "bravo.txt"
    },
    {
      "text": "."
    },
    {
      "expect": ".hidden-synthetic.txt*"
    },
    {
      "text": "."
    },
    {
      "expect_not": ".hidden-synthetic.txt*"
    },
    {
      "expect": "alpha.txt"
    },
    {
      "snapshot": "edge-hidden-toggle.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
