{
  "version": 2,
  "name": "Select and copy one file into a nested directory, then return",
  "command": [
    "nnn",
    "-A",
    "-C",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 160,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "expect": "bravo.txt"
    },
    {
      "text": "/"
    },
    {
      "expect": "str [/], ic [:]"
    },
    {
      "text": "alpha"
    },
    {
      "expect": "/alpha"
    },
    {
      "expect_not": "bravo.txt"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "str [/], ic [:]"
    },
    {
      "expect": "alpha.txt*"
    },
    {
      "text": " "
    },
    {
      "expect": "+alpha.txt*"
    },
    {
      "key": "CtrlL"
    },
    {
      "expect": "bravo.txt"
    },
    {
      "text": "/"
    },
    {
      "expect": "str [/], ic [:]"
    },
    {
      "text": "nested"
    },
    {
      "expect": "/nested"
    },
    {
      "expect_not": "alpha.txt"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "str [/], ic [:]"
    },
    {
      "expect": "nested/"
    },
    {
      "text": "l"
    },
    {
      "expect": "/fixture/nested"
    },
    {
      "expect": "notes café.txt*"
    },
    {
      "text": "p"
    },
    {
      "expect": "alpha.txt*"
    },
    {
      "snapshot": "normal-copy-macos.rows.json"
    },
    {
      "text": "h"
    },
    {
      "expect_not": "/fixture/nested"
    },
    {
      "expect": "protected.txt*"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
