{
  "version": 2,
  "name": "Create a nested Unicode directory tree and verify its empty leaf",
  "command": [
    "nnn",
    "-A",
    "-C",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "screen-256color"
  },
  "width": 160,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "expect": "bravo.txt"
    },
    {
      "text": "n"
    },
    {
      "expect": "['f'ile]/'d'ir/'s'ym/'h'ard?"
    },
    {
      "text": "d"
    },
    {
      "expect": "[path/]name:"
    },
    {
      "text": "created café/sub"
    },
    {
      "expect": "[path/]name: created café/sub"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "[path/]name:"
    },
    {
      "expect": "created café/"
    },
    {
      "text": "l"
    },
    {
      "expect": "/fixture/created café"
    },
    {
      "expect": "sub/"
    },
    {
      "snapshot": "normal-directory-macos.rows.json"
    },
    {
      "text": "l"
    },
    {
      "expect": "/fixture/created café/sub"
    },
    {
      "expect_not": "sub/"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
