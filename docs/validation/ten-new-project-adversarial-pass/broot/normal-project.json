{
  "version": 2,
  "name": "Copy a selected file to a spaced Unicode destination and preserve neighbors",
  "command": [
    "broot",
    "--conf",
    ".configuration/broot.hjson",
    "--no-hidden",
    "."
  ],
  "workspace": {
    "fixture": "fixtures-reviewed",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "BR_INSTALL": "no",
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "text": "alpha"
    },
    {
      "expect": "▶└──alpha"
    },
    {
      "text": ":cp "
    },
    {
      "text": "copied café.txt"
    },
    {
      "expect": "alpha:cp copied café.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Hit alt-Enter to open and quit, esc to clear the filter"
    },
    {
      "key": "Escape"
    },
    {
      "expect": "copied café.txt"
    },
    {
      "snapshot": "normal-project.rows.json"
    },
    {
      "text": ":quit"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    }
  ]
}
