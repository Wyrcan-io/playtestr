{
  "version": 2,
  "name": "Resize a long Unicode preview with observed redraw before dependent navigation",
  "command": [
    "broot",
    "--conf",
    ".configuration/broot.hjson",
    "--no-hidden",
    "."
  ],
  "workspace": {
    "fixture": "fixtures-reviewed",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "BR_INSTALL": "no",
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "text": "long"
    },
    {
      "expect": "▶└──long"
    },
    {
      "text": ":preview_text"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "line 00:"
    },
    {
      "resize": {
        "width": 80,
        "height": 24
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "text": ":page_down"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "line 40:"
    },
    {
      "expect_not": "line 00:"
    },
    {
      "resize": {
        "width": 100,
        "height": 30
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "text": ":page_up"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "1 ▶line 00:"
    },
    {
      "snapshot": "edge-resize-preview.rows.json"
    },
    {
      "text": ":quit"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    }
  ]
}
