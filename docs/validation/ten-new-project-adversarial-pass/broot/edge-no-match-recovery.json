{
  "version": 2,
  "name": "Recover from an unmatched filter and still copy a useful file",
  "command": [
    "broot",
    "--conf",
    ".configuration/broot.hjson",
    "--no-hidden",
    "."
  ],
  "workspace": {
    "fixture": "fixtures-reviewed",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "BR_INSTALL": "no",
    "TERM": "screen-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha.txt"
    },
    {
      "text": "ABSENTNEVERTOKEN"
    },
    {
      "expect": "ABSENTNEVERTOKEN"
    },
    {
      "expect_not": "alpha.txt"
    },
    {
      "key": "Escape"
    },
    {
      "expect": "alpha.txt"
    },
    {
      "text": "alpha"
    },
    {
      "expect": "▶└──alpha"
    },
    {
      "text": ":cp recovered.txt"
    },
    {
      "key": "Enter"
    },
    {
      "key": "Escape"
    },
    {
      "expect": "recovered.txt"
    },
    {
      "snapshot": "edge-no-match-recovery.rows.json"
    },
    {
      "text": ":quit"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    }
  ]
}
