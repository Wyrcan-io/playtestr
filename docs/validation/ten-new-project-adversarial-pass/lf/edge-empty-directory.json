{
  "version": 2,
  "name": "Enter an empty directory and recover to its nonempty parent",
  "command": [
    "lf",
    "-single",
    "-config",
    "lfrc",
    "."
  ],
  "workspace": {
    "fixture": "fixtures-empty",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color",
    "USERNAME": "synthetic-maintainer"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "LF 00-vacant"
    },
    {
      "key": "ArrowRight"
    },
    {
      "text": "r"
    },
    {
      "expect": "rename: empty directory"
    },
    {
      "key": "ArrowLeft"
    },
    {
      "expect": "LF 00-vacant"
    },
    {
      "text": "/"
    },
    {
      "text": "protected.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "LF protected.txt"
    },
    {
      "snapshot": "edge-empty-directory.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
