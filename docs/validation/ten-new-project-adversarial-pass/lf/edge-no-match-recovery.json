{
  "version": 2,
  "name": "Reject an absent glob selection and recover with a genuine selected result",
  "command": [
    "lf",
    "-single",
    "-config",
    "lfrc",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color",
    "USERNAME": "synthetic-maintainer"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "LF 00-empty"
    },
    {
      "text": ":"
    },
    {
      "text": "glob-select absent-never-*"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "pattern not found: absent-never-*"
    },
    {
      "text": "/"
    },
    {
      "text": "bravo.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "LF bravo.txt"
    },
    {
      "expect": "Bravo move source."
    },
    {
      "snapshot": "edge-no-match-recovery.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
