{
  "version": 2,
  "name": "Built-in clipboard copy into an empty directory",
  "command": [
    "lf",
    "-single",
    "-config",
    "lfrc",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color",
    "USERNAME": "synthetic-maintainer"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "LF 00-empty"
    },
    {
      "text": "/"
    },
    {
      "text": "alpha.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "LF alpha.txt"
    },
    {
      "text": "y"
    },
    {
      "text": "/"
    },
    {
      "text": "01-destination"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "LF 01-destination"
    },
    {
      "key": "ArrowRight"
    },
    {
      "text": "p"
    },
    {
      "expect": "LF alpha.txt"
    },
    {
      "expect": "Alpha source retained."
    },
    {
      "snapshot": "normal-copy.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
