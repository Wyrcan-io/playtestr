{
  "version": 2,
  "name": "Filter file names, change ordering and restore the full directory view",
  "command": [
    "lf",
    "-single",
    "-config",
    "lfrc",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color",
    "USERNAME": "synthetic-maintainer"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "LF 00-empty"
    },
    {
      "text": ":"
    },
    {
      "text": "setfilter .txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "LF alpha.txt"
    },
    {
      "expect_not": "LF 00-empty"
    },
    {
      "snapshot": "filter-intermediate.rows.json"
    },
    {
      "text": ":"
    },
    {
      "text": "set sortby size"
    },
    {
      "key": "Enter"
    },
    {
      "text": ":"
    },
    {
      "text": "bottom"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "LF long.txt"
    },
    {
      "text": ":"
    },
    {
      "text": "set sortby natural"
    },
    {
      "key": "Enter"
    },
    {
      "text": ":"
    },
    {
      "text": "setfilter"
    },
    {
      "key": "Enter"
    },
    {
      "text": "/"
    },
    {
      "text": "protected.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "LF protected.txt"
    },
    {
      "expect": "NEIGHBOR MUST REMAIN EXACT"
    },
    {
      "snapshot": "normal-filter-sort-recover.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
