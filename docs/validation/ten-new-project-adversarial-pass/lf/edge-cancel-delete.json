{
  "version": 2,
  "name": "Decline destructive delete confirmation and preserve exact selected file",
  "command": [
    "lf",
    "-single",
    "-config",
    "lfrc",
    "."
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color",
    "USERNAME": "synthetic-maintainer"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "LF 00-empty"
    },
    {
      "text": "/"
    },
    {
      "text": "alpha.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "LF alpha.txt"
    },
    {
      "text": ":"
    },
    {
      "text": "delete"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "delete '"
    },
    {
      "text": "n"
    },
    {
      "expect_not": "delete '"
    },
    {
      "snapshot": "edge-cancel-delete.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    }
  ]
}
