          "expect": "Select license"
        },
        {
          "text": "2"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "include_docs"
        },
        {
          "text": "no"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "metadata"
