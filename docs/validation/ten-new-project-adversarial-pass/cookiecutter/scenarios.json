{
  "project": "cookiecutter",
  "fixture": "fixtures",
  "cases": [
    {
      "name": "normal-project",
      "kind": "normal",
      "purpose": "Generate a nondefault two-file project with dependent slug, chosen license and exact state",
      "command": [
        "cookiecutter",
        "--default-config",
        "--accept-hooks",
        "no",
        "basic"
      ],
      "steps": [
        {
          "expect": "project_name"
        },
        {
          "text": "Investor Fixture"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "project_slug"
        },
        {
          "text": "investor-fixture"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "Select license"
        },
        {
          "text": "2"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "include_docs"
        },
        {
          "text": "no"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "metadata"
        },
        {
          "text": "{\"owner\":\"reviewer\"}"
        },
        {
          "key": "Enter"
        },
        {
          "exit": 0
        }
      ],
      "expected_files": {
        "investor-fixture/README.md": "# Investor Fixture\nLicense=BSD-3-Clause\nDocs=False\n",
        "investor-fixture/data/config.json": "{\"owner\":\"reviewer\",\"slug\":\"investor-fixture\"}\n",
        "sentinel.txt": "outside output preserved\n"
      },
      "absent_paths": [],
      "qualified_hosts": [
        "linux",
        "windows"
      ],
      "timeout_ms": 8000,
      "run_timeout_ms": 120000,
      "output_cap": 2000000,
      "expected_exit": 0
    },
    {
      "name": "normal-structured-data",
      "kind": "normal",
      "purpose": "Structured metadata and Unicode render while declared literal text and binary payload are copied exactly",
      "command": [
        "cookiecutter",
        "--default-config",
        "--accept-hooks",
        "no",
        "structured"
      ],
      "steps": [
        {
          "expect": "project_name"
        },
        {
          "text": "Café Project"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "project_slug"
        },
        {
          "text": "unicode-project"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "Select license"
        },
        {
          "text": "1"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "include_docs"
        },
        {
          "text": "yes"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "metadata"
        },
        {
          "text": "{\"owner\":\"café\"}"
        },
        {
          "key": "Enter"
        },
        {
          "exit": 0
        }
      ],
      "expected_files": {
        "unicode-project/README.md": "# Café Project\nLicense=MIT\nDocs=True\n",
        "unicode-project/data/config.json": "{\"owner\":\"café\",\"slug\":\"unicode-project\"}\n",
        "sentinel.txt": "outside output preserved\n",
        "unicode-project/literal.txt": "{{ cookiecutter.project_name }} remains literal\n",
        "unicode-project/payload.bin": "\u0000\u0001SYNTHETIC-BINARY\n"
      },
      "absent_paths": [],
      "qualified_hosts": [
        "linux",
        "windows"
      ],
      "timeout_ms": 8000,
      "run_timeout_ms": 120000,
      "output_cap": 2000000,
      "expected_exit": 0
    },
    {
      "name": "normal-nested-template",
      "kind": "normal",
      "purpose": "Select a template below an aggregate directory; generated nested source is exact",
      "command": [
        "cookiecutter",
        "--default-config",
        "--accept-hooks",
        "no",
        "--directory",
        "templates/component",
        "nested"
      ],
      "steps": [
        {
          "expect": "project_name"
        },
        {
          "text": "Nested Component"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "project_slug"
        },
        {
          "resize": {
            "width": 80,
            "height": 24
          }
        },
        {
          "text": "nested-component"
        },
        {
          "key": "Enter"
        },
        {
          "exit": 0
        }
      ],
      "expected_files": {
        "nested-component/src/component.txt": "component=Nested Component\n",
        "sentinel.txt": "outside output preserved\n"
      },
      "absent_paths": [],
      "qualified_hosts": [
        "linux",
        "windows"
      ],
      "timeout_ms": 8000,
      "run_timeout_ms": 120000,
      "output_cap": 2000000,
      "expected_exit": 0
    },
    {
      "name": "normal-reviewed-hook",
      "kind": "normal",
      "purpose": "Explicitly approve a reviewed local hook and verify its separate saved effect",
      "command": [
        "cookiecutter",
        "--default-config",
        "--accept-hooks",
        "ask",
        "hooked"
      ],
      "steps": [
        {
          "expect": "Do you want to execute hooks?"
        },
        {
          "text": "y"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "project_name"
        },
        {
          "text": "Hooked Fixture"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "project_slug"
        },
        {
          "text": "hook-result"
        },
        {
          "key": "Enter"
        },
        {
          "expect": "Reviewed local generation hook completed"
        },
        {
          "exit": 0
        }
      ],
      "expected_files": {
        "hook-result/README.md": "# Hooked Fixture\n",
        "hook-result/hook-result.txt": "hook executed\n"
      },
      "absent_paths": [],
      "qualified_hosts": [
        "linux",
        "windows"
      ],
      "timeout_ms": 8000,
      "run_timeout_ms": 120000,
      "output_cap": 2000000,
      "expected_exit": 0
    },
