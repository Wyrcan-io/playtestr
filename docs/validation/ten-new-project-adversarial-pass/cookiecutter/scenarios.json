      "expected_files": {
        "existing/README.md": "original protected bytes\n",
        "existing/neighbor.txt": "neighbor preserved\n",
        "existing/data/config.json": "{\"owner\":\"reviewer\",\"slug\":\"existing\"}\n"
      },
      "absent_paths": [],
      "qualified_hosts": [
        "linux",
        "windows"
      ],
      "timeout_ms": 8000,
      "run_timeout_ms": 120000,
      "output_cap": 2000000,
      "expected_exit": 0
    },
