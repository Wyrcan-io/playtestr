{
  "version": 2,
  "name": "Render metadata, copy binary and preserve literal template text",
  "command": [
    "cookiecutter",
    "--default-config",
    "--accept-hooks",
    "no",
    "structured"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 8000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "project_name"
    },
    {
      "text": "Café Project"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "project_slug"
    },
    {
      "text": "unicode-project"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Select license"
    },
    {
      "text": "1"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "include_docs"
    },
    {
      "text": "yes"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "metadata"
    },
    {
      "text": "{\"owner\":\"café\"}"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "snapshot": "normal-structured-data.txt"
    }
  ]
}
