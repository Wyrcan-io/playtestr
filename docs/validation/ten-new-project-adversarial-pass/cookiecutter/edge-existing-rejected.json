{
  "version": 2,
  "name": "Existing destination is rejected at exact nonzero exit and all original bytes survive",
  "command": [
    "cookiecutter",
    "--default-config",
    "--accept-hooks",
    "no",
    "basic"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 8000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "project_name"
    },
    {
      "text": "Investor Fixture"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "project_slug"
    },
    {
      "text": "existing"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Select license"
    },
    {
      "text": "2"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "include_docs"
    },
    {
      "text": "no"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "metadata"
    },
    {
      "snapshot": "edge-existing-rejected.txt"
    },
    {
      "text": "{\"owner\":\"reviewer\"}"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "already exists"
    },
    {
      "exit": 1
    }
  ]
}
