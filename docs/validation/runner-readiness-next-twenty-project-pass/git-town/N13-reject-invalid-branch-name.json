{
  "command": [
    "git-town",
    "hack",
    "bad name",
    "--no-sync",
    "--non-interactive"
  ],
  "env": {
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_PAGER": "cat",
    "GIT_TERMINAL_PROMPT": "0",
    "PAGER": "cat",
    "TERM": "xterm-256color"
  },
  "name": "Reject an invalid branch name without moving HEAD",
  "run_timeout_ms": 60000,
  "steps": [
    {
      "expect": "not a valid branch name"
    },
    {
      "exit": 1
    },
    {
      "state": {
        "bytes_base64": "cmVmOiByZWZzL2hlYWRzL21haW4K",
        "kind": "file",
        "path": ".git/HEAD"
      }
    }
  ],
  "timeout_ms": 20000,
  "version": 3,
  "workspace": {
    "cwd": ".",
    "fixture": "fixtures/branch-repo",
    "home": "temporary",
    "temp": "temporary"
  }
}
