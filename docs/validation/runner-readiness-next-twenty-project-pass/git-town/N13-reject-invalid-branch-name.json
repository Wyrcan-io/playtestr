{
  "version": 3,
  "name": "Reject an invalid branch name without moving HEAD",
  "command": ["git-town", "hack", "bad name", "--no-sync", "--non-interactive"],
  "workspace": {"fixture": "fixtures/branch-repo", "cwd": ".", "home": "temporary", "temp": "temporary"},
  "steps": [
    {"expect": "not a valid branch name"},
    {"exit": 1},
    {"state": {"path": ".git/HEAD", "kind": "file", "bytes_base64": "cmVmOiByZWZzL2hlYWRzL21haW4K"}}
  ]
}
