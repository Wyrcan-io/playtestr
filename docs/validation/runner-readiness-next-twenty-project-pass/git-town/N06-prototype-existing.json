{
  "version": 3,
  "name": "Make an existing branch a prototype",
  "command": [
    "git-town",
    "prototype",
    "feat-blue"
  ],
  "workspace": {
    "fixture": "fixtures/branch-repo",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "steps": [
    {
      "expect": "branch feat-blue is now a prototype branch"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": ".git/config",
        "kind": "file",
        "bytes_base64": ""
      }
    }
  ],
  "env": {
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_PAGER": "cat",
    "PAGER": "cat",
    "TERM": "xterm-256color"
  }
}
