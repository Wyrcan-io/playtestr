{
  "version": 3,
  "name": "Select an existing Unicode feature branch",
  "command": [
    "git-town",
    "switch",
    "--type",
    "feature"
  ],
  "workspace": {
    "fixture": "fixtures/branch-repo-unicode",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "steps": [
    {
      "expect": "feat-\u00e9"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": ".git/HEAD",
        "kind": "file",
        "bytes_base64": "cmVmOiByZWZzL2hlYWRzL2ZlYXQtw6kK"
      }
    }
  ],
  "env": {
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_PAGER": "cat",
    "PAGER": "cat",
    "TERM": "xterm-256color"
  },
  "timeout_ms": 10000
}
