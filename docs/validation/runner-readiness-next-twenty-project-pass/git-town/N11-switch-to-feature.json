{
  "command": [
    "git-town",
    "switch"
  ],
  "env": {
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_PAGER": "cat",
    "GIT_TERMINAL_PROMPT": "0",
    "PAGER": "cat",
    "TERM": "xterm-256color"
  },
  "name": "Select a feature branch in the visual switcher",
  "run_timeout_ms": 60000,
  "steps": [
    {
      "expect": "feat-blue"
    },
    {
      "key": "ArrowDown"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "feat-blue"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "bytes_base64": "cmVmOiByZWZzL2hlYWRzL2ZlYXQtYmx1ZQo=",
        "kind": "file",
        "path": ".git/HEAD"
      }
    }
  ],
  "timeout_ms": 20000,
  "version": 3,
  "workspace": {
    "cwd": ".",
    "fixture": "fixtures/branch-repo",
    "home": "temporary",
    "temp": "temporary"
  }
}
