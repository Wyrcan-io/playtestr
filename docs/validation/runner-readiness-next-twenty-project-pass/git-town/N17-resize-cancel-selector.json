{
  "command": [
    "git-town",
    "switch"
  ],
  "env": {
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_PAGER": "cat",
    "GIT_TERMINAL_PROMPT": "0",
    "PAGER": "cat",
    "TERM": "xterm-256color"
  },
  "height": 24,
  "name": "Resize the visual selector and cancel without changing HEAD",
  "run_timeout_ms": 60000,
  "steps": [
    {
      "expect": "feat-blue"
    },
    {
      "resize": {
        "height": 18,
        "width": 60
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "expect": "feat-blue"
    },
    {
      "key": "Escape"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "bytes_base64": "cmVmOiByZWZzL2hlYWRzL21haW4K",
        "kind": "file",
        "path": ".git/HEAD"
      }
    }
  ],
  "timeout_ms": 20000,
  "version": 3,
  "width": 80,
  "workspace": {
    "cwd": ".",
    "fixture": "fixtures/branch-repo",
    "home": "temporary",
    "temp": "temporary"
  }
}
