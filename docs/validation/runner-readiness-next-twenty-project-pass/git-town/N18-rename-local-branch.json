{
  "command": [
    "git-town",
    "rename",
    "feat-blue",
    "feat-green"
  ],
  "env": {
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_PAGER": "cat",
    "GIT_TERMINAL_PROMPT": "0",
    "PAGER": "cat",
    "TERM": "xterm-256color"
  },
  "name": "Rename a local branch and verify the exact refs directory",
  "run_timeout_ms": 60000,
  "steps": [
    {
      "expect": "feat-blue"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "entries": [
          "feat-green",
          "main"
        ],
        "kind": "entries",
        "path": ".git/refs/heads"
      }
    }
  ],
  "timeout_ms": 20000,
  "version": 3,
  "workspace": {
    "cwd": ".",
    "fixture": "fixtures/branch-repo",
    "home": "temporary",
    "temp": "temporary"
  }
}
