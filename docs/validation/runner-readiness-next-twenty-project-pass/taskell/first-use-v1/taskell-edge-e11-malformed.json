{
  "version": 3,
  "name": "Reject malformed Taskell Markdown without changing it",
  "command": [
    "taskell",
    "board.md"
  ],
  "workspace": {
    "fixture": "fixtures/e11-malformed",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 5000,
  "run_timeout_ms": 60000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Could not parse file."
    },
    {
      "exit": 1
    },
    {
      "state": {
        "path": "board.md",
        "kind": "file",
        "bytes_base64": "IyMgVG8gRG8KCm5vdCBhIHRhc2sgcm93CgojIyBEb25lCg=="
      }
    }
  ]
}
