    },
    {
      "key": "Enter"
    },
    {
      "expect": "Write a short, imperative tense description"
    },
    {
      "text": "Add a synthetic entry."
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Provide a longer description"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Are there any breaking changes?"
    },
    {
      "key": "Enter"
    },
    {
