{
  "version": 3,
  "name": "Skim N04 frozen direct-PTY scenario v2",
  "command": [
    "../../../../artifacts/runner-readiness-next-twenty-project-pass/active/skim/bin/sk.exe",
    "--no-sort",
    "--multi",
    "--bind=ctrl-a:select-all"
  ],
  "workspace": {
    "fixture": "fixtures/cases/N04",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "SKIM_DEFAULT_COMMAND": "python emit.py"
  },
  "inherit_env": [
    "PATH",
    "SystemRoot",
    "COMSPEC"
  ],
  "width": 120,
  "height": 24,
  "timeout_ms": 10000,
  "startup_timeout_ms": 15000,
  "run_timeout_ms": 30000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "text": "cedar | amber"
    },
    {
      "expect": "2/3"
    },
    {
      "key": "CtrlA"
    },
    {
      "expect": "[2]"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "expect": "cedar"
    },
    {
      "expect": "amber"
    },
    {
      "snapshot": "N04-v2.txt"
    }
  ]
}
