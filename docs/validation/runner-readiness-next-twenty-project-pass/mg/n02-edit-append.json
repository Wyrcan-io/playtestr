{
  "version": 3,
  "name": "mg open existing file, append and save",
  "command": ["mg", "-S", "-n", "notes.txt"],
  "env": {"TERM": "xterm-256color"},
  "workspace": {"fixture": "fixtures/n02-edit-append"},
  "width": 80,
  "height": 24,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {"expect": "BASELINE"},
    {"key": "Escape"},
    {"text": ">"},
    {"text": "APPENDED"},
    {"expect": "APPENDED"},
    {"key": "CtrlX"},
    {"key": "CtrlS"},
    {"expect": "Wrote notes.txt"},
    {"key": "CtrlX"},
    {"key": "CtrlC"},
    {"exit": 0},
    {"state": {"path": "notes.txt", "kind": "file", "bytes_base64": "QkFTRUxJTkUKQVBQRU5ERUQ="}}
  ]
}
