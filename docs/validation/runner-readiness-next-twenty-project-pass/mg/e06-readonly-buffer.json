{
  "version": 3,
  "name": "mg rejects edits in read-only buffer mode",
  "command": [
    "mg",
    "-S",
    "-n",
    "notes.txt"
  ],
  "env": {
    "TERM": "xterm-256color"
  },
  "workspace": {
    "fixture": "fixtures/e06-readonly-buffer"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {
      "expect": "protected sample"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlQ"
    },
    {
      "text": "X"
    },
    {
      "expect": "Buffer is read only"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect": "(No changes need to be saved)"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "notes.txt",
        "kind": "file",
        "bytes_base64": "cHJvdGVjdGVkIHNhbXBsZQo="
      }
    }
  ]
}
