{
  "version": 3,
  "name": "mg cancels save-as filename entry without changing files",
  "command": [
    "mg",
    "-S",
    "-n",
    "notes.txt"
  ],
  "env": {
    "TERM": "xterm-256color"
  },
  "workspace": {
    "fixture": "fixtures/e09-cancel-filename"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {
      "expect": "cancel source"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlW"
    },
    {
      "expect": "Write file"
    },
    {
      "text": "cancelled file.txt"
    },
    {
      "key": "CtrlG"
    },
    {
      "expect": "cancel source"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "notes.txt",
        "kind": "file",
        "bytes_base64": "Y2FuY2VsIHNvdXJjZQo="
      }
    },
    {
      "state": {
        "path": "cancelled file.txt",
        "kind": "absent"
      }
    }
  ]
}
