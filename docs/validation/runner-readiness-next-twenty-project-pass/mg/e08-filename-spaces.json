{
  "version": 3,
  "name": "mg saves as a filename containing spaces",
  "command": [
    "mg",
    "-S",
    "-n",
    "notes.txt"
  ],
  "env": {
    "TERM": "xterm-256color"
  },
  "workspace": {
    "fixture": "fixtures/e08-filename-spaces"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {
      "expect": "spaces source"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlW"
    },
    {
      "expect": "Write file"
    },
    {
      "text": "copy with spaces.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Wrote "
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "notes.txt",
        "kind": "file",
        "bytes_base64": "c3BhY2VzIHNvdXJjZQo="
      }
    },
    {
      "state": {
        "path": "copy with spaces.txt",
        "kind": "file",
        "bytes_base64": "c3BhY2VzIHNvdXJjZQo="
      }
    }
  ]
}
