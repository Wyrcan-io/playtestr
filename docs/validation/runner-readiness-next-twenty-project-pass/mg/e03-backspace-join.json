{
  "version": 3,
  "name": "mg backspace at line start joins the previous line",
  "command": ["mg", "-S", "-n", "notes.txt"],
  "env": {
    "TERM": "xterm-256color"
  },
  "workspace": {
    "fixture": "fixtures/e03-backspace-join"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {"expect": "first"},
    {"expect": "second"},
    {"key": "CtrlN"},
    {"key": "CtrlA"},
    {"key": "Backspace"},
    {"expect": "firstsecond"},
    {"key": "CtrlX"},
    {"key": "CtrlS"},
    {"expect": "Wrote "},
    {"key": "CtrlX"},
    {"key": "CtrlC"},
    {"exit": 0},
    {"state": {"path": "notes.txt", "kind": "file", "bytes_base64": "Zmlyc3RzZWNvbmQK"}}
  ]
}
