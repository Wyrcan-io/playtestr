{
  "version": 3,
  "name": "mg refuses save-as beneath a missing parent",
  "command": [
    "mg",
    "-S",
    "-n",
    "notes.txt"
  ],
  "env": {
    "TERM": "xterm-256color"
  },
  "workspace": {
    "fixture": "fixtures/e07-missing-parent"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {
      "expect": "original content"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlW"
    },
    {
      "expect": "Write file"
    },
    {
      "text": "missing/child.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Cannot open file for writing"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "notes.txt",
        "kind": "file",
        "bytes_base64": "b3JpZ2luYWwgY29udGVudAo="
      }
    },
    {
      "state": {
        "path": "missing",
        "kind": "absent"
      }
    }
  ]
}
