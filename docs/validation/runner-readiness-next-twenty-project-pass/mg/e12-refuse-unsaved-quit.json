{
  "version": 3,
  "name": "mg refuses unsaved quit then saves and exits",
  "command": [
    "mg",
    "-S",
    "-n",
    "notes.txt"
  ],
  "env": {
    "TERM": "xterm-256color"
  },
  "workspace": {
    "fixture": "fixtures/e12-refuse-unsaved-quit"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {
      "expect": "exit source"
    },
    {
      "key": "CtrlE"
    },
    {
      "key": "Enter"
    },
    {
      "text": "pending edit"
    },
    {
      "expect": "pending edit"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlC"
    },
    {
      "expect": "Save file"
    },
    {
      "text": "n"
    },
    {
      "expect": "Modified buffers exist; really exit"
    },
    {
      "text": "n"
    },
    {
      "expect": "pending edit"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect": "Wrote "
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "notes.txt",
        "kind": "file",
        "bytes_base64": "ZXhpdCBzb3VyY2UKcGVuZGluZyBlZGl0Cg=="
      }
    }
  ]
}
