{
  "version": 3,
  "name": "mg deletes a wide UTF-8 character without splitting it",
  "command": [
    "mg",
    "-S",
    "-n",
    "notes.txt"
  ],
  "env": {
    "TERM": "xterm-256color",
    "LANG": "C.UTF-8",
    "LC_CTYPE": "C.UTF-8"
  },
  "workspace": {
    "fixture": "fixtures/e05-wide-backspace"
  },
  "width": 40,
  "height": 12,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {
      "expect": "A\u754cB"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "Backspace"
    },
    {
      "expect": "AB"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect": "Wrote "
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "notes.txt",
        "kind": "file",
        "bytes_base64": "QUIK"
      }
    }
  ]
}
