{
  "version": 3,
  "name": "e10b accept overwrite",
  "command": [
    "mg",
    "-S",
    "-n",
    "notes.txt"
  ],
  "env": {
    "TERM": "xterm-256color"
  },
  "workspace": {
    "fixture": "fixtures/e10b-accept-overwrite"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {
      "expect": "overwrite source"
    },
    {
      "key": "CtrlE"
    },
    {
      "key": "Enter"
    },
    {
      "text": "accepted edit"
    },
    {
      "expect": "accepted edit"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlW"
    },
    {
      "expect": "Write file"
    },
    {
      "text": "existing.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "File `"
    },
    {
      "text": "y"
    },
    {
      "expect": "Wrote "
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "notes.txt",
        "kind": "file",
        "bytes_base64": "b3ZlcndyaXRlIHNvdXJjZQo="
      }
    },
    {
      "state": {
        "path": "existing.txt",
        "kind": "file",
        "bytes_base64": "b3ZlcndyaXRlIHNvdXJjZQphY2NlcHRlZCBlZGl0Cg=="
      }
    }
  ]
}
