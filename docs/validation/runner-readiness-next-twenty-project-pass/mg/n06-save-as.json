{
  "version": 3,
  "name": "mg save the current buffer as a second filename",
  "command": [
    "mg",
    "-S",
    "-n",
    "notes.txt"
  ],
  "env": {
    "TERM": "xterm-256color"
  },
  "workspace": {
    "fixture": "fixtures/n06-save-as"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {
      "expect": "source remains"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlW"
    },
    {
      "expect": "Write file:"
    },
    {
      "key": "CtrlU"
    },
    {
      "text": "notes-copy.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Wrote "
    },
    {
      "expect": "source remains"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "notes.txt",
        "kind": "file",
        "bytes_base64": "c291cmNlIHJlbWFpbnMK"
      }
    },
    {
      "state": {
        "path": "notes-copy.txt",
        "kind": "file",
        "bytes_base64": "c291cmNlIHJlbWFpbnMK"
      }
    }
  ]
}
