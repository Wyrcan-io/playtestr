{
  "version": 3,
  "name": "mg cut a marked word and yank it at line end",
  "command": [
    "mg",
    "-S",
    "-n",
    "notes.txt"
  ],
  "env": {
    "TERM": "xterm-256color"
  },
  "workspace": {
    "fixture": "fixtures/n04-cut-yank"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 8000,
  "run_timeout_ms": 30000,
  "startup_timeout_ms": 15000,
  "steps": [
    {
      "expect": "alpha beta gamma"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "CtrlSpace"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "CtrlF"
    },
    {
      "key": "CtrlF"
    },
    {
      "expect": "alpha beta gamma"
    },
    {
      "key": "CtrlW"
    },
    {
      "expect": "alpha  gamma"
    },
    {
      "key": "CtrlE"
    },
    {
      "key": "CtrlY"
    },
    {
      "expect": "alpha  gamma beta"
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect": "Wrote "
    },
    {
      "key": "CtrlX"
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "notes.txt",
        "kind": "file",
        "bytes_base64": "YWxwaGEgIGdhbW1hIGJldGEK"
      }
    }
  ]
}
