{
  "version": 3,
  "name": "Use the documented regular-expression finder",
  "command": [
    "/bin/sh",
    "-c",
    "exec \"$PERCOL_PYTHON\" \"$PERCOL_SOURCE/bin/percol\" --match-method=regex '--query=^pine$' < choices.txt > result.txt"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  "inherit_env": [
    "PATH",
    "PERCOL_PYTHON",
    "PERCOL_SOURCE",
    "PYTHONPATH",
    "DYLD_LIBRARY_PATH"
  ],
  "width": 80,
  "height": 12,
  "timeout_ms": 20000,
  "run_timeout_ms": 60000,
  "max_output_bytes": 1048576,
  "steps": [
    {
      "expect": "pine"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "result.txt",
        "kind": "file",
        "bytes_base64": "cGluZQo="
      }
    }
  ]
}
