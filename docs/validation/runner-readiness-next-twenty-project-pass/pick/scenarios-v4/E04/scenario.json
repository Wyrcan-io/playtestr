{
  "command": [
    "/bin/sh",
    "-c",
    "exec pick -d < choices.txt"
  ],
  "env": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "TERM": "xterm-256color"
  },
  "height": 24,
  "inherit_env": [
    "PATH"
  ],
  "max_output_bytes": 1048576,
  "name": "Do not fuzzy-match a description as though it were the label",
  "run_timeout_ms": 60000,
  "steps": [
    {
      "expect": "same first"
    },
    {
      "text": "second"
    },
    {
      "expect_not": "same"
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 1
    }
  ],
  "timeout_ms": 12000,
  "version": 3,
  "width": 80,
  "workspace": {
    "cwd": ".",
    "fixture": "fixtures",
    "home": "temporary",
    "temp": "temporary"
  }
}
