{
  "command": [
    "/bin/sh",
    "-c",
    "exec pick -q '\u96ea' < choices.txt"
  ],
  "env": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "TERM": "xterm-256color"
  },
  "height": 24,
  "inherit_env": [
    "PATH"
  ],
  "max_output_bytes": 1048576,
  "name": "Filter UTF-8 choices by a non-ASCII query",
  "run_timeout_ms": 60000,
  "steps": [
    {
      "expect": "\u96ea\u5c71"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "\u96ea\u5c71"
    }
  ],
  "timeout_ms": 12000,
  "version": 3,
  "width": 80,
  "workspace": {
    "cwd": ".",
    "fixture": "fixtures",
    "home": "temporary",
    "temp": "temporary"
  }
}
