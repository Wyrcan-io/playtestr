{
  "version": 3,
  "name": "Create and save a named note",
  "command": [
    "joe",
    "-nobackups",
    "new-note.txt"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "TERM": "xterm-256color"
  },
  "inherit_env": [
    "PATH"
  ],
  "width": 80,
  "height": 24,
  "timeout_ms": 12000,
  "run_timeout_ms": 60000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "new-note.txt"
    },
    {
      "text": "fresh note"
    },
    {
      "expect": "fresh note"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "x"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "new-note.txt",
        "kind": "file",
        "bytes_base64": "ZnJlc2ggbm90ZQ=="
      }
    },
    {
      "state": {
        "path": ".keep",
        "kind": "file",
        "bytes_base64": ""
      }
    }
  ]
}
