{
  "version": 3,
  "name": "Correct a selected line without changing its neighbors",
  "command": [
    "joe",
    "-nobackups",
    "note.txt"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "TERM": "xterm-256color"
  },
  "inherit_env": [
    "PATH"
  ],
  "width": 80,
  "height": 24,
  "timeout_ms": 12000,
  "run_timeout_ms": 60000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha"
    },
    {
      "key": "ArrowDown"
    },
    {
      "key": "Home"
    },
    {
      "expect": "bravo"
    },
    {
      "text": "reviewed "
    },
    {
      "expect": "reviewed bravo"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "x"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "note.txt",
        "kind": "file",
        "bytes_base64": "YWxwaGEKcmV2aWV3ZWQgYnJhdm8KY2hhcmxpZQo="
      }
    }
  ]
}
