{
  "version": 3,
  "name": "Replace the current line with a corrected line",
  "command": [
    "joe",
    "-nobackups",
    "note.txt"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "TERM": "xterm-256color"
  },
  "inherit_env": [
    "PATH"
  ],
  "width": 80,
  "height": 24,
  "timeout_ms": 12000,
  "run_timeout_ms": 60000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "obsolete line"
    },
    {
      "key": "CtrlY"
    },
    {
      "text": "corrected line"
    },
    {
      "expect": "corrected line"
    },
    {
      "expect": "keep this line"
    },
    {
      "key": "CtrlK"
    },
    {
      "text": "x"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "note.txt",
        "kind": "file",
        "bytes_base64": "Y29ycmVjdGVkIGxpbmUKa2VlcCB0aGlzIGxpbmUK"
      }
    }
  ]
}
