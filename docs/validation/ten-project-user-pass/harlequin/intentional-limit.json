{
  "version": 2,
  "name": "Intentional public query limit change",
  "command": [
    "/var/tmp/playtestr-user-pass-harlequin-08/venv/bin/harlequin",
    "--adapter",
    "sqlite",
    "--theme",
    "textual-dark",
    "notes.db",
    "--limit",
    "1"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 15000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "^s Save Query"
    },
    {
      "text": "select name,quantity from items order by name;"
    },
    {
      "expect": "select name,quantity from items order by name;"
    },
    {
      "key": "CtrlJ"
    },
    {
      "expect": "Query Results (Showing 1 of >1 Records)"
    },
    {
      "snapshot": "intentional-limit.rows.json"
    }
  ]
}
