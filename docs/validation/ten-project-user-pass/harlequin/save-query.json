{
  "version": 2,
  "name": "Save Unicode SQL buffer and independently verify exact file bytes",
  "command": [
    "/var/tmp/playtestr-user-pass-harlequin-08/venv/bin/harlequin",
    "--adapter",
    "sqlite",
    "--theme",
    "textual-dark",
    "notes.db"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 15000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "^s Save Query"
    },
    {
      "text": "select 'café' as saved_value;"
    },
    {
      "expect": "select 'café' as saved_value;"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect": "Enter file path OR press ESC to cancel"
    },
    {
      "text": "reviewed.sql"
    },
    {
      "expect": "Saving to"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "Enter file path OR press ESC to cancel"
    },
    {
      "expect": "Editor contents saved to"
    },
    {
      "snapshot": "saved-editor-row.rows.json"
    }
  ]
}
