{
  "version": 2,
  "name": "Execute actual SQLite query in editor and render ordered Unicode result rows",
  "command": [
    "/var/tmp/playtestr-user-pass-harlequin-08/venv/bin/harlequin",
    "--adapter",
    "sqlite",
    "--theme",
    "textual-dark",
    "notes.db"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 5000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "^s Save Query"
    },
    {
      "text": "select name,quantity from items order by name;"
    },
    {
      "key": "CtrlJ"
    },
    {
      "expect": "café"
    },
    {
      "snapshot": "query.txt"
    }
  ]
}
