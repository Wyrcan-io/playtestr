{
  "version": 2,
  "name": "Search actual table data and move to the matching beta row",
  "command": [
    "/var/tmp/playtestr-user-pass-visidata-06/venv/bin/vd",
    "--nothing",
    "--disp-status-fmt",
    "{sheet.name} row={sheet.cursorRowIndex} ",
    "--disp-rstatus-fmt",
    "{sheet.nRows} rows",
    "data.tsv"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 5000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha"
    },
    {
      "text": "/"
    },
    {
      "expect": "search"
    },
    {
      "text": "beta"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "row=1"
    },
    {
      "snapshot": "search.txt"
    }
  ]
}
