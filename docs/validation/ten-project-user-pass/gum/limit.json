{
  "version": 2,
  "name": "Enforce application input length without silently truncating the test contract",
  "command": [
    "../../../../.cache/ten-project-apps/gum-01/gum",
    "input",
    "--placeholder",
    "Code",
    "--char-limit",
    "3",
    "--cursor.mode",
    "static"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 5000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Code"
    },
    {
      "text": "abcd"
    },
    {
      "expect": "abc"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "snapshot": "limit.txt"
    }
  ]
}
