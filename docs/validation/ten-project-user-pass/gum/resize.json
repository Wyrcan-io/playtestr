{
  "version": 2,
  "name": "Resize and verify cursor selection before accepting output",
  "command": [
    "../../../../.cache/ten-project-apps/gum-01/gum",
    "choose",
    "alpha",
    "beta",
    "gamma"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 5000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Choose:"
    },
    {
      "resize": {
        "width": 80,
        "height": 24
      }
    },
    {
      "key": "ArrowDown"
    },
    {
      "expect": "\u003e beta"
    },
    {
      "snapshot": "resize.txt"
    }
  ]
}
