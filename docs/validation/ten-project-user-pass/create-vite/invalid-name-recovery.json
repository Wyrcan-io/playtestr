    {
      "key": "Backspace"
    },
    {
      "key": "Backspace"
    },
    {
      "key": "Backspace"
    },
    {
      "key": "Backspace"
    },
    {
      "key": "Backspace"
    },
    {
      "key": "Backspace"
    },
    {
      "key": "Backspace"
    },
    {
      "text": "valid-vue-name"
    },
    {
      "expect": "valid-vue-name"
