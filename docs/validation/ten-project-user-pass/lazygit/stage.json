{
  "version": 2,
  "name": "Stage a modified file and independently verify the Git index",
  "command": [
    "python3",
    "launch.py",
    "--git",
    "lazygit",
    "--use-config-file",
    "config.yml"
  ],
  "workspace": {
    "fixture": "fixtures",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 30,
  "timeout_ms": 5000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": " M seed.txt"
    },
    {
      "text": " "
    },
    {
      "expect": "M  seed.txt"
    },
    {
      "snapshot": "stage.txt"
    }
  ]
}
