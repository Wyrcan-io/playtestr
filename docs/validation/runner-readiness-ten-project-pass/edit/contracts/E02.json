{
  "version": 3,
  "name": "Edit E02: cancel an unsaved exit then keep editing and save",
  "command": [
    "edit",
    "note.txt"
  ],
  "workspace": {
    "fixture": "fixtures/E02",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "inherit_env": [
    "SystemDrive"
  ],
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "reviewed seed"
    },
    {
      "key": "End"
    },
    {
      "text": " staged"
    },
    {
      "expect": "reviewed seed staged"
    },
    {
      "key": "CtrlQ"
    },
    {
      "expect": "Unsaved Changes"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "Unsaved Changes"
    },
    {
      "text": " recovered"
    },
    {
      "expect": "reviewed seed staged recovered"
    },
    {
      "expect": "*"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect_not": "*"
    },
    {
      "key": "CtrlQ"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "note.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgc2VlZCBzdGFnZWQgcmVjb3ZlcmVkCg=="
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "note.txt",
          "sentinel.txt"
        ]
      }
    }
  ]
}
