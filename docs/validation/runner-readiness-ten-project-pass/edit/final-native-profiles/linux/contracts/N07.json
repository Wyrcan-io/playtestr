{
  "version": 3,
  "name": "Edit N07: save two documents across an active-file transition",
  "command": [
    "edit",
    "alpha.txt",
    "beta.txt"
  ],
  "workspace": {
    "fixture": "fixtures/N07",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "beta document"
    },
    {
      "key": "End"
    },
    {
      "text": " + checked"
    },
    {
      "expect": "beta document + checked"
    },
    {
      "expect": "*"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect_not": "*"
    },
    {
      "key": "CtrlW"
    },
    {
      "expect": "alpha document"
    },
    {
      "key": "End"
    },
    {
      "text": " + checked"
    },
    {
      "expect": "alpha document + checked"
    },
    {
      "expect": "*"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect_not": "*"
    },
    {
      "key": "CtrlQ"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "alpha.txt",
        "kind": "file",
        "bytes_base64": "YWxwaGEgZG9jdW1lbnQgKyBjaGVja2VkCg=="
      }
    },
    {
      "state": {
        "path": "beta.txt",
        "kind": "file",
        "bytes_base64": "YmV0YSBkb2N1bWVudCArIGNoZWNrZWQK"
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "alpha.txt",
          "beta.txt",
          "sentinel.txt"
        ]
      }
    }
  ]
}
