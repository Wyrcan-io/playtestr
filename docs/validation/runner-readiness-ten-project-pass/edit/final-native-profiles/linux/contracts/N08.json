{
  "version": 3,
  "name": "Edit N08: find and replace the selected first match",
  "command": [
    "edit",
    "note.txt"
  ],
  "workspace": {
    "fixture": "fixtures/N08",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "alpha alpha"
    },
    {
      "key": "CtrlF"
    },
    {
      "expect": "Find:"
    },
    {
      "text": "alpha"
    },
    {
      "key": "CtrlR"
    },
    {
      "expect": "Replace:"
    },
    {
      "key": "Tab"
    },
    {
      "text": "beta"
    },
    {
      "key": "Enter"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "Replace:"
    },
    {
      "expect": "beta alpha"
    },
    {
      "expect": "*"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect_not": "*"
    },
    {
      "key": "CtrlQ"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "note.txt",
        "kind": "file",
        "bytes_base64": "YmV0YSBhbHBoYQo="
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "note.txt",
          "sentinel.txt"
        ]
      }
    }
  ]
}
