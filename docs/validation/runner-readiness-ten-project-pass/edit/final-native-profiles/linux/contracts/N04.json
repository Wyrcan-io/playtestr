{
  "version": 3,
  "name": "Edit N04: undo and redo the last inserted group",
  "command": [
    "edit",
    "note.txt"
  ],
  "workspace": {
    "fixture": "fixtures/N04",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "reviewed seed"
    },
    {
      "key": "End"
    },
    {
      "text": " + redo"
    },
    {
      "expect": "reviewed seed + redo"
    },
    {
      "expect": "+ redo"
    },
    {
      "key": "CtrlZ"
    },
    {
      "expect_not": "+ redo"
    },
    {
      "expect": "reviewed seed"
    },
    {
      "key": "CtrlY"
    },
    {
      "expect": "reviewed seed + redo"
    },
    {
      "expect": "*"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect_not": "*"
    },
    {
      "snapshot": "N04.txt"
    },
    {
      "key": "CtrlQ"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "note.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgc2VlZCArIHJlZG8K"
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "note.txt",
          "sentinel.txt"
        ]
      }
    }
  ]
}
