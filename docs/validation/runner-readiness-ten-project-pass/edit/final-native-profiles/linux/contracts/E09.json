{
  "version": 3,
  "name": "Edit E09: clamp an out-of-range command-line position safely",
  "command": [
    "edit",
    "--goto",
    "note.txt:999:999"
  ],
  "workspace": {
    "fixture": "fixtures/E09",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "last"
    },
    {
      "text": "!"
    },
    {
      "expect": "last!"
    },
    {
      "expect": "*"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect_not": "*"
    },
    {
      "key": "CtrlQ"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "note.txt",
        "kind": "file",
        "bytes_base64": "Zmlyc3QKbGFzdCE="
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "note.txt",
          "sentinel.txt"
        ]
      }
    }
  ]
}
