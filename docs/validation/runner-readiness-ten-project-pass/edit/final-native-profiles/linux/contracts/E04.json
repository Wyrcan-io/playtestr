{
  "version": 3,
  "name": "Edit E04: save an emptied document as exactly zero bytes",
  "command": [
    "edit",
    "empty.txt"
  ],
  "workspace": {
    "fixture": "fixtures/E04",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "empty.txt"
    },
    {
      "text": "ephemeral"
    },
    {
      "expect": "ephemeral"
    },
    {
      "key": "CtrlA"
    },
    {
      "key": "Backspace"
    },
    {
      "expect_not": "ephemeral"
    },
    {
      "expect": "*"
    },
    {
      "key": "CtrlS"
    },
    {
      "expect_not": "*"
    },
    {
      "key": "CtrlQ"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "empty.txt",
        "kind": "file",
        "bytes_base64": ""
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "empty.txt",
          "sentinel.txt"
        ]
      }
    }
  ]
}
