{
  "version": 3,
  "name": "Vis E04: delete all text and persist exactly zero bytes",
  "command": [
    "vis",
    "empty.txt"
  ],
  "workspace": {
    "fixture": "fixtures/E04",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "LC_ALL": "C.UTF-8",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "temporary"
    },
    {
      "text": "dd"
    },
    {
      "expect_not": "temporary"
    },
    {
      "expect": "[+]"
    },
    {
      "text": ":w"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "[+]"
    },
    {
      "text": ":q"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "empty.txt",
        "kind": "file",
        "bytes_base64": ""
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "sentinel.txt",
          "empty.txt"
        ]
      }
    }
  ]
}
