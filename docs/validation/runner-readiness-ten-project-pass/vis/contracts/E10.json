{
  "version": 3,
  "name": "Vis E10: force reload to discard changes then save a new edit",
  "command": [
    "vis",
    "note.txt"
  ],
  "workspace": {
    "fixture": "fixtures/E10",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "LC_ALL": "C.UTF-8",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "reviewed seed"
    },
    {
      "text": "A"
    },
    {
      "expect": "INSERT"
    },
    {
      "text": " discarded"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "INSERT"
    },
    {
      "expect": "reviewed seed discarded"
    },
    {
      "text": ":e!"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "reviewed seed discarded"
    },
    {
      "text": "A"
    },
    {
      "expect": "INSERT"
    },
    {
      "text": " retained"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "INSERT"
    },
    {
      "expect": "reviewed seed retained"
    },
    {
      "expect": "[+]"
    },
    {
      "text": ":w"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "[+]"
    },
    {
      "text": ":q"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "note.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgc2VlZCByZXRhaW5lZAo="
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "note.txt",
          "sentinel.txt"
        ]
      }
    }
  ]
}
