{
  "version": 3,
  "name": "Vis E08: resize a dirty document and retain fresh ordered edits",
  "command": [
    "vis",
    "note.txt"
  ],
  "workspace": {
    "fixture": "fixtures/E08",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "LC_ALL": "en_US.UTF-8",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "reviewed seed"
    },
    {
      "text": "A"
    },
    {
      "expect": "INSERT"
    },
    {
      "text": " + resized"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "INSERT"
    },
    {
      "resize": {
        "width": 40,
        "height": 12
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "text": "A"
    },
    {
      "expect": "INSERT"
    },
    {
      "text": " narrow"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "INSERT"
    },
    {
      "expect": "resized narrow"
    },
    {
      "resize": {
        "width": 100,
        "height": 28
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "text": "A"
    },
    {
      "expect": "INSERT"
    },
    {
      "text": " wide"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "INSERT"
    },
    {
      "expect": "resized narrow wide"
    },
    {
      "expect": "[+]"
    },
    {
      "text": ":w"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "[+]"
    },
    {
      "snapshot": "E08.txt"
    },
    {
      "text": ":q"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "note.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgc2VlZCArIHJlc2l6ZWQgbmFycm93IHdpZGUK"
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "note.txt",
          "sentinel.txt"
        ]
      }
    }
  ]
}
