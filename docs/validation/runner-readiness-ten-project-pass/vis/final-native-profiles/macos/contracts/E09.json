{
  "version": 3,
  "name": "Vis E09: recover from an unknown editor command",
  "command": [
    "vis",
    "note.txt"
  ],
  "workspace": {
    "fixture": "fixtures/E09",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "LC_ALL": "en_US.UTF-8",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "reviewed seed"
    },
    {
      "text": ":no-such-command"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Unknown command"
    },
    {
      "expect": "no-such-command"
    },
    {
      "key": "CtrlC"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "no-such-command"
    },
    {
      "text": "A"
    },
    {
      "expect": "INSERT"
    },
    {
      "text": " recovered"
    },
    {
      "key": "Escape"
    },
    {
      "expect_not": "INSERT"
    },
    {
      "expect": "reviewed seed recovered"
    },
    {
      "expect": "[+]"
    },
    {
      "text": ":w"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "[+]"
    },
    {
      "text": ":q"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "note.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgc2VlZCByZWNvdmVyZWQK"
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "note.txt",
          "sentinel.txt"
        ]
      }
    }
  ]
}
