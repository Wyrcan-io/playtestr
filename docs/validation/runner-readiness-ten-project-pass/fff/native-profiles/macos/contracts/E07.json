{
  "version": 3,
  "name": "fff E07: show a hidden file then rename it with bytes preserved",
  "command": [
    "fff"
  ],
  "workspace": {
    "fixture": "fixtures/E07",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "FFF_CD_ON_EXIT": "1",
    "FFF_LS_COLORS": "0",
    "FFF_TRASH": "trash",
    "LC_ALL": "en_US.UTF-8",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "sentinel.txt"
    },
    {
      "text": "."
    },
    {
      "expect": ".hidden.txt"
    },
    {
      "text": "/.hidden.txt"
    },
    {
      "expect": "/.hidden.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "/.hidden.txt"
    },
    {
      "text": "r"
    },
    {
      "expect": "rename .hidden.txt:"
    },
    {
      "text": "visible.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "rename .hidden.txt:"
    },
    {
      "expect": "visible.txt"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": "visible.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgc291cmNlCg=="
      }
    },
    {
      "state": {
        "path": ".hidden.txt",
        "kind": "absent"
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "visible.txt",
          "trash",
          "sentinel.txt"
        ]
      }
    },
    {
      "state": {
        "path": "trash",
        "kind": "entries",
        "entries": []
      }
    }
  ]
}
