{
  "version": 3,
  "name": "fff E11: resize and create files in both viewports",
  "command": [
    "fff"
  ],
  "workspace": {
    "fixture": "fixtures/E11",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "FFF_CD_ON_EXIT": "1",
    "FFF_LS_COLORS": "0",
    "FFF_TRASH": "trash",
    "LC_ALL": "C.UTF-8",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "source.txt"
    },
    {
      "resize": {
        "width": 40,
        "height": 12
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "text": "f"
    },
    {
      "expect": "mkfile:"
    },
    {
      "text": "narrow.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "mkfile:"
    },
    {
      "expect": "narrow.txt"
    },
    {
      "resize": {
        "width": 100,
        "height": 28
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "text": "f"
    },
    {
      "expect": "mkfile:"
    },
    {
      "text": "wide.txt"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "mkfile:"
    },
    {
      "expect": "wide.txt"
    },
    {
      "snapshot": "E11.rows.json"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "narrow.txt",
        "kind": "file",
        "bytes_base64": ""
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": "source.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgc291cmNlCg=="
      }
    },
    {
      "state": {
        "path": "wide.txt",
        "kind": "file",
        "bytes_base64": ""
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "wide.txt",
          "trash",
          "sentinel.txt",
          "narrow.txt",
          "source.txt"
        ]
      }
    },
    {
      "state": {
        "path": "trash",
        "kind": "entries",
        "entries": []
      }
    }
  ]
}
