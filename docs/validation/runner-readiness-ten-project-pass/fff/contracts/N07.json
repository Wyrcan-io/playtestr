{
  "version": 3,
  "name": "fff N07: copy a directory tree with nested and hidden contents",
  "command": [
    "fff"
  ],
  "workspace": {
    "fixture": "fixtures/N07",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "FFF_CD_ON_EXIT": "1",
    "FFF_LS_COLORS": "0",
    "FFF_TRASH": "trash",
    "LC_ALL": "C.UTF-8",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "bundle/"
    },
    {
      "expect": "(1/4)"
    },
    {
      "text": "G"
    },
    {
      "expect": "(4/4)"
    },
    {
      "text": "g"
    },
    {
      "expect": "(1/4)"
    },
    {
      "text": "y"
    },
    {
      "expect": "[1] selected"
    },
    {
      "text": ":"
    },
    {
      "expect": "go to dir:"
    },
    {
      "text": "destination"
    },
    {
      "key": "Enter"
    },
    {
      "expect_not": "go to dir:"
    },
    {
      "expect": "anchor.txt"
    },
    {
      "text": "p"
    },
    {
      "expect": "bundle/"
    },
    {
      "expect_not": "[1] selected"
    },
    {
      "text": "q"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "bundle/.hidden",
        "kind": "file",
        "bytes_base64": "aGlkZGVuIGJ5dGVzCg=="
      }
    },
    {
      "state": {
        "path": "bundle/nested/deep.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgc291cmNlCg=="
      }
    },
    {
      "state": {
        "path": "destination/anchor.txt",
        "kind": "file",
        "bytes_base64": "ZGVzdGluYXRpb24gYW5jaG9yCg=="
      }
    },
    {
      "state": {
        "path": "destination/bundle/.hidden",
        "kind": "file",
        "bytes_base64": "aGlkZGVuIGJ5dGVzCg=="
      }
    },
    {
      "state": {
        "path": "destination/bundle/nested/deep.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgc291cmNlCg=="
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgcmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "destination",
          "trash",
          "bundle",
          "sentinel.txt"
        ]
      }
    },
    {
      "state": {
        "path": "bundle",
        "kind": "entries",
        "entries": [
          "nested",
          ".hidden"
        ]
      }
    },
    {
      "state": {
        "path": "bundle/nested",
        "kind": "entries",
        "entries": [
          "deep.txt"
        ]
      }
    },
    {
      "state": {
        "path": "destination",
        "kind": "entries",
        "entries": [
          "bundle",
          "anchor.txt"
        ]
      }
    },
    {
      "state": {
        "path": "destination/bundle",
        "kind": "entries",
        "entries": [
          "nested",
          ".hidden"
        ]
      }
    },
    {
      "state": {
        "path": "destination/bundle/nested",
        "kind": "entries",
        "entries": [
          "deep.txt"
        ]
      }
    },
    {
      "state": {
        "path": "trash",
        "kind": "entries",
        "entries": []
      }
    }
  ]
}
