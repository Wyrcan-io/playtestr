    },
    {
      "text": "focus-marker-probe"
    },
    {
      "expect": "probe"
    },
    {
      "text": "\u0015"
    },
    {
      "expect_not": "probe"
    },
    {
      "text": "beta.md"
    },
    {
      "expect": "beta.md"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Wide cells"
    },
    {
      "resize": {
        "width": 70,
        "height": 28
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "text": "\u000e"
    },
    {
      "expect_not": "Contents"
    },
    {
      "resize": {
        "width": 100,
        "height": 28
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "text": "\u000e"
    },
    {
      "expect": "Contents"
    },
    {
      "snapshot": "E12.rows.json"
    },
    {
      "text": "\u0011"
    },
