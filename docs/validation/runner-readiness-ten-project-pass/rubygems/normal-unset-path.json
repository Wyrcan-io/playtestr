{
  "version": 3,
  "name": "Bundler N05",
  "command": [
    "ruby",
    "-EUTF-8",
    "-S",
    "bundle",
    "config",
    "unset",
    "--local",
    "path"
  ],
  "workspace": {
    "fixture": "config-fixture",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "BUNDLE_DISABLE_VERSION_CHECK": "true",
    "BUNDLE_USER_CONFIG": ".bundle-user-config",
    "BUNDLE_VERSION": "system",
    "GEMRC": "nul",
    "GIT_CONFIG_GLOBAL": "nul",
    "GIT_CONFIG_NOSYSTEM": "1"
  },
  "inherit_env": [
    "RUBYLIB"
  ],
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "exit": 0
    },
    {
      "state": {
        "path": ".bundle/config",
        "kind": "file",
        "bytes_base64": "LS0tDQpCVU5ETEVfV0lUSE9VVDogZGV2ZWxvcG1lbnQNCg=="
      }
    },
    {
      "state": {
        "path": "Gemfile",
        "kind": "file",
        "bytes_base64": "IyByZXZpZXdlZCBkZXBlbmRlbmN5LWZyZWUgcHJvamVjdAo="
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    }
  ]
}
