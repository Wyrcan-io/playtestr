{
  "version": 3,
  "name": "Bundler E01",
  "command": [
    "ruby",
    "-EUTF-8",
    "-S",
    "bundle",
    "gem",
    "123invalid",
    "--no-git",
    "--no-bundle",
    "--no-ci",
    "--no-mit",
    "--no-coc",
    "--no-changelog",
    "--no-linter",
    "--test=rspec"
  ],
  "workspace": {
    "fixture": "fixture",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "BUNDLE_DISABLE_VERSION_CHECK": "true",
    "BUNDLE_USER_CONFIG": ".bundle-user-config",
    "BUNDLE_VERSION": "system",
    "GEMRC": "nul",
    "GIT_CONFIG_GLOBAL": "nul",
    "GIT_CONFIG_NOSYSTEM": "1"
  },
  "inherit_env": [
    "RUBYLIB",
    "SystemDrive"
  ],
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Invalid gem name"
    },
    {
      "exit": 1
    },
    {
      "state": {
        "path": "123invalid",
        "kind": "absent"
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    }
  ]
}
