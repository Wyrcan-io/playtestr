{
  "version": 3,
  "name": "Bundler E02",
  "command": [
    "/usr/bin/ruby3.2",
    "-EUTF-8",
    "-S",
    "bundle",
    "gem",
    "atlas",
    "--no-git",
    "--no-bundle",
    "--no-ci",
    "--no-mit",
    "--no-coc",
    "--no-changelog",
    "--no-linter",
    "--test=rspec"
