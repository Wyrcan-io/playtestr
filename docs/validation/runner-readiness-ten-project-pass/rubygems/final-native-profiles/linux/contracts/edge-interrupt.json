{
  "version": 3,
  "name": "Bundler E03",
  "command": [
    "/usr/bin/ruby3.2",
    "-EUTF-8",
    "-S",
    "bundle",
    "gem",
    "atlas",
    "--no-git",
    "--no-bundle",
    "--no-ci",
    "--no-mit",
    "--no-coc",
    "--no-changelog",
    "--no-linter"
  ],
  "workspace": {
    "fixture": "fixture",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "BUNDLE_DISABLE_VERSION_CHECK": "true",
    "BUNDLE_USER_CONFIG": ".bundle-user-config",
    "BUNDLE_VERSION": "system",
    "GEMRC": "/dev/null",
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_NOSYSTEM": "1"
  },
  "inherit_env": [
    "RUBYLIB"
  ],
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Enter a test framework."
    },
    {
      "key": "CtrlC"
    },
    {
      "exit": 1
    },
    {
      "state": {
        "path": "atlas",
        "kind": "absent"
      }
    },
    {
      "state": {
        "path": ".bundle-user-config",
        "kind": "absent"
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    }
  ]
}
