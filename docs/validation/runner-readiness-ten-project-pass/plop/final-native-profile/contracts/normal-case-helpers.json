{
  "version": 3,
  "name": "Plop N08",
  "command": [
    "plop",
    "--no-progress",
    "--plopfile",
    "extended.cjs",
    "case-helpers"
  ],
  "workspace": {
    "fixture": "fixture",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Module identifier"
    },
    {
      "text": "Hello World"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "hello-world.txt"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "case/hello-world.txt",
        "kind": "file",
        "bytes_base64": "Y2xhc3MgSGVsbG9Xb3JsZAo="
      }
    }
  ]
}
