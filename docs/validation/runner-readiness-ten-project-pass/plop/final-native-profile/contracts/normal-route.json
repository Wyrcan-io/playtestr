    {
      "text": "beta"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "registry.txt"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "registry.txt",
        "kind": "file",
        "bytes_base64": "cHJlZml4PXByZXNlcnZlClJPVVRFUwpyb3V0ZT1iZXRhCnN1ZmZpeD1wcmVzZXJ2ZQo="
      }
    }
  ]
}
