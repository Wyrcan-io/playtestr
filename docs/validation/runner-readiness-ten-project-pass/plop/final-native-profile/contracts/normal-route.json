{
  "version": 3,
  "name": "Plop N03",
  "command": [
    "plop",
    "--no-progress",
    "--plopfile",
    "extended.cjs",
    "route"
  ],
  "workspace": {
    "fixture": "fixture",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Route name"
