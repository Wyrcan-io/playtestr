{
  "version": 3,
  "name": "Plop E05",
  "command": [
    "cmd.exe",
    "/d",
    "/s",
    "/c",
    "plop --no-progress --plopfile extended.cjs"
  ],
  "workspace": {
    "fixture": "fixture",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 80,
  "height": 12,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Please choose a generator."
    },
    {
      "resize": {
        "width": 100,
        "height": 16
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "resize": {
        "width": 80,
        "height": 12
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "key": "ArrowDown"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Route name"
    },
    {
      "text": "resized"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "registry.txt"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "registry.txt",
        "kind": "file",
        "bytes_base64": "cHJlZml4PXByZXNlcnZlClJPVVRFUwpyb3V0ZT1yZXNpemVkCnN1ZmZpeD1wcmVzZXJ2ZQo="
      }
    },
    {
      "state": {
        "path": "modules",
        "kind": "absent"
      }
    }
  ]
}
