{
  "version": 3,
  "name": "Plop E10",
  "command": [
    "cmd.exe",
    "/d",
    "/s",
    "/c",
    "plop --no-progress --plopfile extended.cjs missing-template"
  ],
  "workspace": {
    "fixture": "fixture",
    "home": "temporary",
    "temp": "temporary"
  },
  "width": 80,
  "height": 24,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Missing template artifact"
    },
    {
      "text": "alpha"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "ENOENT"
    },
    {
      "exit": 1
    },
    {
      "state": {
        "path": "missing-output.txt",
        "kind": "absent"
      }
    }
  ]
}
