{
  "version": 3,
  "env": {
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_NOSYSTEM": "1",
    "POETRY_KEYRING_ENABLED": "false",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONNOUSERSITE": "1"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "name": "Poetry N06",
  "command": [
    "poetry",
    "--no-plugins",
    "source",
    "remove",
    "private"
  ],
  "workspace": {
    "fixture": "source-fixture",
    "home": "temporary",
    "temp": "temporary"
  },
  "steps": [
    {
      "expect": "Removing source with name private."
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "pyproject.toml",
        "kind": "file",
        "bytes_base64": ""
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    }
  ]
}
