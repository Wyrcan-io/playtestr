{
  "version": 3,
  "env": {
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_NOSYSTEM": "1",
    "POETRY_KEYRING_ENABLED": "false",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONNOUSERSITE": "1"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "name": "Poetry E06",
  "command": [
    "poetry",
    "--no-plugins",
    "new",
    "--interactive",
    "--name",
    "company.service",
    "--description",
    "Fixture project",
    "--author",
    "Fixture Author <author@example.invalid>",
    "--python",
    ">=3.10",
    "--license",
    "MIT",
    "caf\u00e9 space/atlas"
  ],
  "workspace": {
    "fixture": "fixture",
    "home": "temporary",
    "temp": "temporary"
  },
  "steps": [
    {
      "expect": "Version ["
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Author ["
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Would you like to define your main dependencies interactively?"
    },
    {
      "text": "n"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Would you like to define your development dependencies interactively?"
    },
    {
      "text": "n"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Do you confirm generation?"
    },
    {
      "text": "yes"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Created package company.service"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "caf\u00e9 space/atlas/pyproject.toml",
        "kind": "file",
        "bytes_base64": ""
      }
    },
    {
      "state": {
        "path": "caf\u00e9 space/atlas",
        "kind": "entries",
        "entries": [
          "README.md",
          "pyproject.toml",
          "src",
          "tests"
        ]
      }
    },
    {
      "state": {
        "path": "caf\u00e9 space/atlas/src",
        "kind": "entries",
        "entries": [
          "company"
        ]
      }
    },
    {
      "state": {
        "path": "caf\u00e9 space/atlas/src/company",
        "kind": "entries",
        "entries": [
          "service"
        ]
      }
    },
    {
      "state": {
        "path": "caf\u00e9 space/atlas/src/company/service/__init__.py",
        "kind": "file",
        "bytes_base64": ""
      }
    },
    {
      "state": {
        "path": "caf\u00e9 space/atlas/tests/__init__.py",
        "kind": "file",
        "bytes_base64": ""
      }
    },
    {
      "state": {
        "path": "caf\u00e9 space/atlas/README.md",
        "kind": "file",
        "bytes_base64": ""
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgZXhpc3Rpbmcgd29yawo="
      }
    }
  ]
}
