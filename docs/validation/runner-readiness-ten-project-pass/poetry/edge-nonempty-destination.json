{
  "version": 3,
  "env": {
    "GIT_CONFIG_GLOBAL": "nul",
    "GIT_CONFIG_NOSYSTEM": "1",
    "POETRY_KEYRING_ENABLED": "false",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONNOUSERSITE": "1"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "name": "Poetry E04",
  "command": [
    "poetry",
    "--no-plugins",
    "new",
    "--interactive",
    "--name",
    "company.service",
    "--description",
    "Fixture project",
    "--author",
    "Fixture Author <author@example.invalid>",
    "--python",
    ">=3.10",
    "--license",
    "MIT",
    "nested/atlas"
  ],
  "workspace": {
    "fixture": "collision-fixture",
    "home": "temporary",
    "temp": "temporary"
  },
  "steps": [
    {
      "expect": "exists and is not empty"
    },
    {
      "exit": 1
    },
    {
      "state": {
        "path": "nested/atlas/keep.txt",
        "kind": "file",
        "bytes_base64": "cmV2aWV3ZWQgb3JpZ2luYWwK"
      }
    },
    {
      "state": {
        "path": "nested/atlas",
        "kind": "entries",
        "entries": [
          "keep.txt"
        ]
      }
    },
    {
      "state": {
        "path": "nested/atlas/pyproject.toml",
        "kind": "absent"
      }
    }
  ]
}
