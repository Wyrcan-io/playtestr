{
  "version": 3,
  "name": "papis E10: handle an empty synthetic library without writing an export",
  "command": [
    "papis",
    "--config",
    "config.ini",
    "--lib",
    "library",
    "--np",
    "1",
    "--color",
    "no",
    "--set",
    "exporter-csv-keys",
    "['title','year']",
    "export",
    "--format",
    "csv",
    "--out",
    "result.csv",
    "--sort",
    "title"
  ],
  "workspace": {
    "fixture": "fixtures/E10",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONIOENCODING": "utf-8",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 15000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "No documents retrieved"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "config.ini",
        "kind": "file",
        "bytes_base64": "W3NldHRpbmdzXQpwaWNrdG9vbCA9IHByb21wdF90b29sa2l0CmRhdGFiYXNlLWJhY2tlbmQgPSBwYXBpcwp1c2UtZ2l0ID0gZmFsc2UK"
      }
    },
    {
      "state": {
        "path": "sentinel.txt",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUgaW5kZXBlbmRlbnQgZXhpc3Rpbmcgd29yawo="
      }
    },
    {
      "state": {
        "path": "result.csv",
        "kind": "absent"
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "config.ini",
          "library",
          "sentinel.txt"
        ]
      }
    },
    {
      "state": {
        "path": "library",
        "kind": "entries",
        "entries": []
      }
    }
  ]
}
