{
  "version": 3,
  "name": "papis N06: remove one attached file with explicit confirmation",
  "command": [
    "papis",
    "--config",
    "config.ini",
    "--lib",
    "library",
    "--np",
    "1",
    "--color",
    "no",
    "--set",
    "exporter-csv-keys",
    "['title','year']",
    "rm",
    "--file",
    "--sort",
    "title"
  ],
  "workspace": {
    "fixture": "fixtures/N06",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONIOENCODING": "utf-8",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 15000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Alpha Book"
    },
    {
      "key": "ArrowDown"
    },
    {
      "expect": "2/2"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "1/2"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Are you sure?"
    },
    {
      "text": "y"
    },
    {
      "key": "Enter"
    },
    {
      "expect": "Removing file"
    },
    {
      "exit": 0
    },
    {
