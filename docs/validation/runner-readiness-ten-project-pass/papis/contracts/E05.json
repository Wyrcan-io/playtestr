{
  "version": 3,
  "name": "papis E05: export a Unicode folder and preserve binary attachments",
  "command": [
    "papis",
    "--config",
    "config.ini",
    "--lib",
    "library",
    "--np",
    "1",
    "--color",
    "no",
    "--set",
    "exporter-csv-keys",
    "['title','year']",
    "export",
    "--folder",
    "--out",
    "exported",
    "--sort",
    "title"
  ],
  "workspace": {
    "fixture": "fixtures/E05",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONIOENCODING": "utf-8",
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 15000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
