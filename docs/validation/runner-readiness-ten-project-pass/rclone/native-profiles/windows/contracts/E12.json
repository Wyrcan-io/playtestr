{
  "version": 3,
  "name": "Rclone E12: resize active Unicode name entry and require fresh post-resize markers",
  "command": [
    "rclone",
    "--config",
    "rclone.conf",
    "config"
  ],
  "workspace": {
    "fixture": "fixtures/E12",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "No remotes found, make a new one?"
    },
    {
      "text": "n\r"
    },
    {
      "expect": "name>"
    },
    {
      "text": "caf\u00e9 \u96ea"
    },
    {
      "expect": "caf\u00e9 \u96ea"
    },
    {
      "resize": {
        "width": 70,
        "height": 20
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "text": "A"
    },
    {
      "key": "ArrowRight"
    },
    {
      "expect": "caf\u00e9 \u96eaA"
    },
    {
      "resize": {
        "width": 100,
        "height": 28
      }
    },
    {
      "wait_for_redraw": true
    },
    {
      "text": "B"
    },
    {
      "key": "ArrowRight"
    },
    {
      "expect": "caf\u00e9 \u96eaAB"
    },
    {
      "text": "\r"
    },
    {
      "expect": "Storage>"
    },
    {
      "text": "alias\r"
    },
    {
      "expect": "remote>"
    },
    {
      "text": ".\r"
    },
    {
      "expect": "Edit advanced config?"
    },
    {
      "text": "n\r"
    },
    {
      "expect": "Keep this \"caf\u00e9 \u96eaAB\" remote?"
    },
    {
      "text": "y\r"
    },
    {
      "expect": "Current remotes:"
    },
    {
      "snapshot": "E12-final.txt"
    },
    {
      "text": "q\r"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "rclone.conf",
        "kind": "file",
        "bytes_base64": "W2NhZsOpIOmbqkFCXQ0KdHlwZSA9IGFsaWFzDQpyZW1vdGUgPSAuDQoNCg=="
      }
    },
    {
      "state": {
        "path": "sentinel.bin",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUAZXhpc3RpbmcNCg=="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "rclone.conf",
          "sentinel.bin"
        ]
      }
    }
  ]
}
