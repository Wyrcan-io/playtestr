{
  "version": 3,
  "name": "Rclone N06: change the local path of an existing alias",
  "command": [
    "rclone",
    "--config",
    "rclone.conf",
    "config"
  ],
  "workspace": {
    "fixture": "fixtures/N06",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "env": {
    "TERM": "xterm-256color"
  },
  "width": 100,
  "height": 28,
  "timeout_ms": 10000,
  "run_timeout_ms": 120000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Current remotes:"
    },
    {
      "text": "e\r"
    },
    {
      "expect": "remote>"
    },
    {
      "text": "seed\r"
    },
    {
      "expect": "Enter a value of type string. Press Enter for the default (old).\nremote>"
    },
    {
      "text": "new\r"
    },
    {
      "expect": "remote> new\n\nEdit advanced config?\ny) Yes\nn) No (default)\ny/n>"
    },
    {
      "text": "n\r"
    },
    {
      "expect": "Configuration complete.\nOptions:\n- type: alias\n- remote: new\nKeep this \"seed\" remote?\ny) Yes this is OK (default)\ne) Edit this remote\nd) Delete this remote\ny/e/d>"
    },
    {
      "text": "y\r"
    },
    {
      "expect": "Current remotes:"
    },
    {
      "snapshot": "N06-final.txt"
    },
    {
      "text": "q\r"
    },
    {
      "exit": 0
    },
    {
      "state": {
        "path": "new/keep.txt",
        "kind": "file",
        "bytes_base64": "bmV3Cg=="
      }
    },
    {
      "state": {
        "path": "old/keep.txt",
        "kind": "file",
        "bytes_base64": "b2xkCg=="
      }
    },
    {
      "state": {
        "path": "rclone.conf",
        "kind": "file",
        "bytes_base64": "W3NlZWRdDQp0eXBlID0gYWxpYXMNCnJlbW90ZSA9IG5ldw0KDQo="
      }
    },
    {
      "state": {
        "path": "sentinel.bin",
        "kind": "file",
        "bytes_base64": "cHJlc2VydmUAZXhpc3RpbmcNCg=="
      }
    },
    {
      "state": {
        "path": ".",
        "kind": "entries",
        "entries": [
          "new",
          "old",
          "rclone.conf",
          "sentinel.bin"
        ]
      }
    },
    {
      "state": {
        "path": "new",
        "kind": "entries",
        "entries": [
          "keep.txt"
        ]
      }
    },
    {
      "state": {
        "path": "old",
        "kind": "entries",
        "entries": [
          "keep.txt"
        ]
      }
    }
  ]
}
