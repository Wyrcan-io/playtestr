{
  "schemaVersion": 1,
  "id": "turn-counter",
  "command": "node",
  "args": ["turn-counter.mjs"],
  "terminal": { "cols": 80, "rows": 24 },
  "startupTimeoutMs": 1000,
  "stepTimeoutMs": 60,
  "exitGraceMs": 2500,
