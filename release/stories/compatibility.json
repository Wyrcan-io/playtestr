{
  "version": 1,
  "name": "Release story: preserve modal state across resize",
  "command": ["./artifacts/release-stories/bin/compatibility"],
  "inherit_env": ["COMPAT_RESULT_PATH"],
  "width": 60,
  "height": 12,
  "timeout_ms": 5000,
  "run_timeout_ms": 10000,
  "max_output_bytes": 100000,
  "steps": [
    {"expect": "Main screen"},
    {"text": "?"},
    {"expect": "Help modal"},
    {"resize": {"width": 80, "height": 20}},
    {"key": "Enter"},
    {"expect": "Size: 80x20"},
    {"key": "Escape"},
    {"expect_not": "Help modal"},
    {"expect": "Press ? for help"},
    {"text": "q"},
    {"exit": 0}
  ]
}
