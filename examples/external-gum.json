{
  "version": 1,
  "name": "Choose an option in Charm Gum",
  "command": ["./.tools/external/gum", "choose", "Alpha", "Beta", "Gamma", "--header", "Pick deployment"],
  "width": 60,
  "height": 12,
  "timeout_ms": 5000,
