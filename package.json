{
  "name": "@wyrcan/playtestr",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Evidence-first autonomous playtesting for terminal games",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wyrcan-io/playtestr.git"
  },
  "bugs": {
    "url": "https://github.com/Wyrcan-io/playtestr/issues"
  },
  "homepage": "https://github.com/Wyrcan-io/playtestr#readme",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "playtestr": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "npm run build && node dist/cli.js run --manifest fixtures/turn-counter.json --profile explore --max-actions 10 --artifacts artifacts/smoke --trust-target",
    "soak": "npm run build && node scripts/lifecycle-soak.mjs 100"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "1.2.0-beta.14"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
